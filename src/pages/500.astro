---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`500 · ${SITE_TITLE}`} description="Internal server error." />
	</head>
	<body>
		<Header />
		<main class="container err">
			<p class="mono-label" data-i18n="err.code500">SYS.ERR / 500</p>
			<h1 class="code">500</h1>
			<p class="lede" data-i18n="err.title500">Something went wrong — 出了点问题</p>
			<a href="/" class="home-btn mono" data-i18n="err.home">← HOME</a>
		</main>
		<Footer />
		<style>
			.err {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				min-height: 60vh;
				padding-block: 3rem 5rem;
			}
			.code {
				font-family: var(--font-mono);
				font-size: clamp(6rem, 18vw, 11rem);
				font-weight: 900;
				line-height: 1;
				letter-spacing: 0.02em;
				margin: 0.8rem 0 0.6rem;
			}
			.lede {
				font-size: 1.05em;
				color: var(--ink-soft);
			}
			.home-btn {
				display: inline-block;
				margin-top: 2rem;
				padding: 10px 20px;
				border: 1px solid var(--line-strong);
				border-radius: 7px;
				color: var(--ink-soft);
				font-size: 13px;
				letter-spacing: 0.12em;
				text-decoration: none;
				transition:
					color 0.15s ease,
					border-color 0.15s ease,
					background 0.15s ease;
			}
			.home-btn:hover {
				color: var(--paper);
				background: var(--ink);
				border-color: var(--ink);
			}
		</style>
	</body>
</html>
