---
// giscus 评论组件 — 数据存于 GitHub Discussions
// 前置：仓库已开 Discussions；需安装 giscus app: https://github.com/apps/giscus
// 主题跟随站点明暗切换；语言由页面路由（/zh/）在构建期决定
import { ui, type Lang } from '../i18n';

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
---

<section class="comments">
	<link rel="preconnect" href="https://giscus.app" />
	<div class="comments-head">
		<h2 class="mono-label">{t['comments.title']}</h2>
	</div>
	<div class="giscus-mount"></div>
</section>

<script is:inline>
	(function () {
		var mount = document.currentScript.parentElement.querySelector('.giscus-mount');
		var d = document.documentElement;
		// giscus 部件运行在 https 的 iframe 里：页面为 http（本地 dev/preview）时引用本地
		// 样式会被混合内容拦截，改用线上已部署的主题 CSS；https 环境用当前 origin
		var SITE = location.protocol === 'https:' ? location.origin : 'https://timmycheng.cn';
		var THEME_LIGHT = SITE + '/giscus-theme.css';
		var THEME_DARK = SITE + '/giscus-theme-dark.css';
		var LANG = document.documentElement.getAttribute('data-giscus-lang') || 'en';

		function themeUrl() {
			return d.getAttribute('data-theme') === 'dark' ? THEME_DARK : THEME_LIGHT;
		}

		function inject() {
			var old = mount.querySelector('script');
			if (old) old.remove();
			var s = document.createElement('script');
			s.src = 'https://giscus.app/client.js';
			s.setAttribute('data-repo', 'timmycheng/timmycheng.github.io');
			s.setAttribute('data-repo-id', 'MDEwOlJlcG9zaXRvcnk0MDM5MDYzNTM=');
			s.setAttribute('data-category', 'Announcements');
			s.setAttribute('data-category-id', 'DIC_kwDOGBMfMc4DENaE');
			s.setAttribute('data-mapping', 'pathname');
			s.setAttribute('data-strict', '0');
			s.setAttribute('data-reactions-enabled', '1');
			s.setAttribute('data-emit-metadata', '0');
			s.setAttribute('data-input-position', 'top');
			s.setAttribute('data-theme', themeUrl());
			s.setAttribute('data-lang', LANG);
			s.setAttribute('data-loading', 'lazy');
			s.crossOrigin = 'anonymous';
			s.async = true;
			mount.appendChild(s);
		}

		inject();
		document.addEventListener('tc-theme-change', function () {
			var iframe = mount.querySelector('iframe.giscus-frame');
			if (iframe && iframe.contentWindow) {
				iframe.contentWindow.postMessage(
					{ giscus: { setConfig: { theme: themeUrl() } } },
					'https://giscus.app',
				);
			}
		});
	})();
</script>

<style>
	.comments {
		margin-top: 3.5rem;
		padding-top: 1.8rem;
		border-top: 1px solid var(--line-strong);
	}
</style>
