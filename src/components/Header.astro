---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
	<nav>
		<a href="/" class="logo" aria-label={SITE_TITLE}>
			<span class="logo-mark">T</span>
			<span class="logo-text">
				Shxt<span class="logo-dot">.</span>In<span class="logo-dot">.</span>Mind
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/works">Works</HeaderLink>
		</div>
		<div class="controls">
			<a class="ctl rss-btn" href="/rss.xml" aria-label="RSS feed">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
					<path d="M4 4c8.837 0 16 7.163 16 16h-4c0-6.627-5.373-12-12-12V4z"></path>
					<circle cx="6" cy="18" r="2"></circle>
					<path d="M4 11c5 0 9 4 9 9h-3c0-3.314-2.686-6-6-6v-3z"></path>
				</svg>
			</a>
			<button type="button" class="ctl theme-btn" data-action="theme" aria-label="Toggle theme">
				<svg
					class="icon-moon"
					viewBox="0 0 24 24"
					width="16"
					height="16"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
				<svg
					class="icon-sun"
					viewBox="0 0 24 24"
					width="16"
					height="16"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
			</button>
		</div>
	</nav>
</header>
<script>
	const header = document.querySelector('.site-header');
	if (header) {
		let lastY = window.scrollY;
		const update = () => {
			const y = window.scrollY;
			header.classList.toggle('is-scrolled', y > 8);
			if (y > lastY && y > 240) header.classList.add('is-hidden');
			else header.classList.remove('is-hidden');
			lastY = y;
		};
		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>
<style>
	header.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition:
			border-color var(--duration) var(--ease-out),
			transform 0.36s var(--ease-out);
	}
	header.site-header.is-scrolled {
		border-bottom-color: var(--line-strong);
	}
	header.site-header.is-hidden {
		transform: translateY(-100%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1060px;
		margin: 0 auto;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 14px 0;
		text-decoration: none;
		flex-shrink: 0;
	}
	.logo:hover {
		color: inherit;
	}
	.logo-mark {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 7px;
		background: var(--accent);
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 700;
	}
	.logo-text {
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.03em;
	}
	.logo-dot {
		color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}
	.ctl {
		border: 1px solid var(--line-strong);
		border-radius: 7px;
		background: transparent;
		color: var(--ink-soft);
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.ctl:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.rss-btn {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
	}
	.theme-btn {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		padding: 0;
	}
	.theme-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.theme-btn svg {
		grid-area: 1 / 1;
		transition:
			opacity 0.2s ease,
			transform 0.25s ease;
	}
	/* 亮色时显示月亮（点击进暗色），暗色时显示太阳 */
	.theme-btn .icon-sun {
		opacity: 0;
		transform: rotate(-60deg) scale(0.6);
	}
	:global(html[data-theme='dark']) .theme-btn .icon-moon {
		opacity: 0;
		transform: rotate(60deg) scale(0.6);
	}
	:global(html[data-theme='dark']) .theme-btn .icon-sun {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		.logo-text {
			display: none;
		}
		.internal-links {
			gap: 0;
		}
	}
</style>
