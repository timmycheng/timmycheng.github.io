---
import { getCollection } from 'astro:content';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import FormattedDate from '../FormattedDate.astro';
import Header from '../Header.astro';
import { ui, type Lang } from '../../i18n';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { parseEntry, workHref } from '../../utils/works';
import { readingMinutes } from '../../utils/reading';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const base = lang === 'zh' ? '/zh' : '';

// 首页只展示当前语言的内容
const posts = (await getCollection('works'))
	.filter((p) => parseEntry(p).lang === lang)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const [lead, ...rest] = posts;

const tiles = [
	{
		no: '01',
		key: 'about',
		label: t['nav.about'],
		alt: t['nav.about.alt'],
		desc: t['t.about.desc'],
		href: `${base}/about`,
	},
	{
		no: '02',
		key: 'works',
		label: t['nav.works'],
		alt: t['nav.works.alt'],
		desc: t['t.works.desc'],
		href: `${base}/works`,
	},
];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
	<head>
		<BaseHead
			title={lang === 'zh' ? `${SITE_TITLE} — 安全运营工程师` : SITE_TITLE}
			description={lang === 'zh' ? t['hero.lede'] : SITE_DESCRIPTION}
			lang={lang}
			alternateUrl={lang === 'zh' ? '/' : '/zh/'}
		/>
	</head>
	<body>
		<Header langSwitchHref={lang === 'zh' ? '/' : '/zh/'} />
		<main id="main-content" class="container">
			<section class="hero">
				<span class="watermark mono" aria-hidden="true">T/</span>
				<div class="hero-main">
					<p class="mono-label">timmycheng.cn — EST.2026</p>
					<h1 class="name">SHXT<br />IN MIND<span class="accent">.</span></h1>
					<p class="lede">{t['hero.lede']}</p>
				</div>
				<div class="console mono">
					<div class="console-bar">
						<span>SYS.CONFIG</span>
						<span class="console-dots">:::</span>
					</div>
					<dl>
						<div class="crow"><dt>ROLE</dt><span class="leader"></span><dd>Security Ops</dd></div>
						<div class="crow"><dt>FOCUS</dt><span class="leader"></span><dd>Detection</dd></div>
						<div class="crow">
							<dt>STACK</dt><span class="leader"></span><dd>Detection / Research</dd>
						</div>
						<div class="crow"><dt>BASE</dt><span class="leader"></span><dd>CN · UTC+8</dd></div>
						<div class="crow">
							<dt>STATUS</dt><span class="leader"></span><dd class="ok">
								<i class="dot"></i>ONLINE
							</dd>
						</div>
					</dl>
				</div>
			</section>

			<section class="sections">
				<h2 class="section-title">{t['home.sections']}</h2>
				<div class="tiles" aria-label="Sections">
					{
						tiles.map((tile) => (
							<a class="tile" href={tile.href}>
								<span class="no mono">{tile.no}</span>
								<span class="zh">{tile.label}</span>
								<span class="en mono">{tile.alt}</span>
								<span class="desc">{tile.desc}</span>
								<span class="arrow mono">→</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="latest">
				<h2 class="section-title">{t['latest.title']}</h2>
				{
					lead && (
						<article class="feed-card lead-card">
							<a class="title-link" href={workHref(parseEntry(lead).slug, lang)}>
								<div class="meta-row">
									<span>
										<FormattedDate date={lead.data.pubDate} lang={lang} />
									</span>
									<span class="read">
										<span class="num">{readingMinutes(lead.body ?? '')}</span> {t['read.min']}
									</span>
								</div>
								<h2 class="title">{lead.data.title}</h2>
								<p class="excerpt">{lead.data.description}</p>
								<span class="more link-nudge">
									{t['post.read']} <span class="arrow">→</span>
								</span>
							</a>
						</article>
					)
				}
				<div class="feed">
					{
						rest.map((post) => (
							<article class="feed-card">
								<a class="title-link" href={workHref(parseEntry(post).slug, lang)}>
									<div class="meta-row">
										<span>
											<FormattedDate date={post.data.pubDate} lang={lang} />
										</span>
										<span class="read">
											<span class="num">{readingMinutes(post.body ?? '')}</span> {t['read.min']}
										</span>
									</div>
									<h2 class="title">{post.data.title}</h2>
									<p class="excerpt">{post.data.description}</p>
									<span class="more link-nudge">
										{t['post.read']} <span class="arrow">→</span>
									</span>
								</a>
							</article>
						))
					}
				</div>
				<a href={`${base}/works`} class="mono more link-sweep">{t['latest.all']}</a>
			</section>
		</main>
		<Footer />
		<style>
			.accent {
				color: var(--accent);
			}
			/* ── hero：左右两列从顶部平行 ── */
			.hero {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto;
				align-items: center;
				gap: 3rem;
				padding: 1.5rem 0 3rem;
				overflow: hidden;
			}
			.hero-main {
				position: relative;
				z-index: 1;
			}
			.watermark {
				position: absolute;
				right: -1rem;
				bottom: -1rem;
				font-size: 22rem;
				line-height: 1;
				font-weight: 700;
				color: var(--ink);
				opacity: 0.04;
				pointer-events: none;
				user-select: none;
			}
			.name {
				font-size: clamp(2.6rem, 7vw, 4.8rem);
				line-height: 0.95;
				letter-spacing: -0.045em;
				margin: 0.9rem 0 1.2rem;
			}
			.lede {
				max-width: 30em;
				margin: 0;
				font-size: 1.06em;
				color: var(--ink-soft);
			}
			/* ── 控制台面板 ── */
			.console {
				position: relative;
				z-index: 1;
				min-width: 250px;
				border: 1px solid var(--line-strong);
				background: var(--paper-raise);
			}
			.console-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 5px 10px;
				background: var(--ink);
				color: var(--paper);
				font-size: 10px;
				letter-spacing: 0.22em;
			}
			.console-dots {
				color: var(--accent);
			}
			.console dl {
				margin: 0;
				padding: 0.35rem 10px;
			}
			.crow {
				display: flex;
				align-items: baseline;
				gap: 0.6rem;
				padding: 0.5rem 0;
				font-size: 12px;
			}
			.crow dt {
				color: var(--ink-faint);
				letter-spacing: 0.12em;
				flex-shrink: 0;
			}
			.leader {
				flex: 1;
				border-bottom: 1px dotted var(--line-strong);
				transform: translateY(-3px);
			}
			.crow dd {
				margin: 0;
				font-weight: 600;
				flex-shrink: 0;
			}
			.crow .ok {
				color: var(--accent);
			}
			.crow .dot {
				display: inline-block;
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--accent);
				margin-right: 6px;
				animation: blink 2.4s ease-in-out infinite;
			}
			@keyframes blink {
				50% {
					opacity: 0.35;
				}
			}
			/* ── sections ── */
			.sections {
				margin-top: 1rem;
			}
			/* ── tiles：一行三块，悬停反色 ── */
			.tiles {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1px;
				background: var(--line-strong);
				border: 1px solid var(--line-strong);
			}
			.tile {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto;
				grid-template-areas:
					'no arrow'
					'zh arrow'
					'en en'
					'desc desc';
				row-gap: 0.2rem;
				column-gap: 1rem;
				padding: 1.2rem 1.2rem 1.1rem;
				background: var(--paper);
				text-decoration: none;
				transition: background 0.18s ease;
			}
			.tile:hover {
				background: var(--ink);
			}
			.tile .no {
				grid-area: no;
				font-size: 12px;
				font-weight: 700;
				color: var(--accent);
			}
			.tile .zh {
				grid-area: zh;
				font-size: 1.35rem;
				font-weight: 800;
				letter-spacing: 0.02em;
				line-height: 1.15;
			}
			.tile .en {
				grid-area: en;
				font-size: 11px;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				color: var(--ink-faint);
			}
			.tile .desc {
				grid-area: desc;
				margin-top: 0.5rem;
				font-size: 0.88em;
				color: var(--ink-soft);
			}
			.tile .arrow {
				grid-area: arrow;
				align-self: start;
				font-size: 16px;
				color: var(--ink-faint);
				transition:
					transform 0.18s ease,
					color 0.18s ease;
			}
			.tile:hover .zh,
			.tile:hover .desc {
				color: var(--paper);
			}
			.tile:hover .en,
			.tile:hover .arrow {
				color: var(--paper-deep);
			}
			.tile:hover .arrow {
				transform: translate(3px, -3px);
				color: var(--accent);
			}
			/* ── latest feed ── */
			.latest {
				margin-top: 4rem;
			}
			.latest .feed {
				margin-top: 2.75rem;
			}
			.latest > .more {
				display: inline-block;
				margin-top: 2.5rem;
				font-size: 13px;
				color: var(--ink-soft);
			}
			.latest > .more:hover {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 2rem;
					padding: 2rem 0 2.5rem;
				}
				.watermark {
					font-size: 14rem;
					right: -2rem;
					bottom: -3rem;
				}
				.tiles {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
