---
import { SITE_TITLE } from '../consts';

const today = new Date();
const year = today.getFullYear();
---

<footer>
	<div class="inner">
		<div class="meta">
			<span class="mono">&copy; {year} {SITE_TITLE}</span>
			<span class="sep">/</span>
			<span class="mono">timmycheng.cn</span>
		</div>
		<a class="mono beian" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">
			京ICP备XXXXXXXX号
		</a>
		<div class="social-links">
			<a href="https://github.com/timmycheng" target="_blank" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line-strong);
		padding: 1.6rem 1.5rem;
		background: transparent;
	}
	.inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: 1000px;
		max-width: calc(100% - 3rem);
		margin: 0 auto;
	}
	.meta {
		display: flex;
		gap: 0.75rem;
		justify-self: start;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.sep {
		color: var(--ink-faint);
	}
	.beian {
		justify-self: center;
		color: var(--ink-soft);
		font-size: 13px;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.beian:hover {
		color: var(--accent);
	}
	.social-links {
		display: flex;
		gap: 0.75rem;
		justify-self: end;
	}
	.social-links a {
		display: grid;
		place-items: center;
		color: var(--ink-soft);
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.inner {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
		}
	}
</style>
