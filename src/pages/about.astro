---
// 内容来自 src/data/about.ts（与小程序 /api/about.json 共用单一数据源）。
// 双语用 [data-lang] 成对渲染，由 global.css 按 data-locale 切换（与 works 页同机制）。
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { about } from '../data/about';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`About · ${SITE_TITLE}`}
			description="About Timmy Cheng — cybersecurity engineer, focused on security operations."
		/>
		<script is:inline>
			// About 页局部语言：仅本页生效，避免渲染闪烁
			(function () {
				var d = document.documentElement;
				if (localStorage.getItem('tc-locale-about') === 'zh') {
					d.setAttribute('data-locale', 'zh');
					d.lang = 'zh-CN';
				}
			})();
		</script>
	</head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<div class="about-grid">
				<section class="intro">
					<button
						type="button"
						class="locale-btn mono"
						data-action="about-locale"
						aria-label="Toggle language"
					>
						中 / EN
					</button>
					<h2>{about.name}</h2>
					<p class="mono-label">{about.role}</p>
					<p class="bio">
						<span data-lang="en">{about.bio.en}</span>
						<span data-lang="zh">{about.bio.zh}</span>
					</p>
					<p class="bio-note mono">
						<span data-lang="en">{about.resumeNote.en}</span>
						<span data-lang="zh">{about.resumeNote.zh}</span>
					</p>
					<ul class="socials" aria-label="Social links">
						<li>
							<a
								class="social-btn"
								href={about.socials.github}
								target="_blank"
								rel="noopener"
								aria-label="GitHub"
							>
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path
										fill="currentColor"
										d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
									></path>
								</svg>
							</a>
						</li>
						<li>
							<button
								type="button"
								class="social-btn"
								data-wechat-id={about.socials.wechat}
								aria-label="WeChat"
								title={`WeChat: ${about.socials.wechat}`}
							>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path
										d="M9.5 4C5.36 4 2 6.69 2 10c0 1.89 1.08 3.56 2.78 4.66l-.69 2.09 2.4-1.2c.62.2 1.28.32 1.96.36-.16-.52-.25-1.08-.25-1.66C8.2 10.9 10.76 8 14.5 8h.08C13.66 5.66 11.8 4 9.5 4zM7 7.75c.41 0 .75.34.75.75s-.34.75-.75.75-.75-.34-.75-.75.34-.75.75-.75z"
									></path>
									<path
										d="M14.5 9c-3.04 0-5.5 2.01-5.5 4.5s2.46 4.5 5.5 4.5c.63 0 1.24-.11 1.8-.3l2.2 1.1-.63-1.92c1.53-.99 2.63-2.5 2.63-4.38C20.5 11.01 18.04 9 14.5 9zm-1.5 4.75c-.41 0-.75-.34-.75-.75s.34-.75.75-.75.75.34.75.75-.34.75-.75.75zm3 0c-.41 0-.75-.34-.75-.75s.34-.75.75-.75.75.34.75.75-.34.75-.75.75z"
									></path>
								</svg>
							</button>
						</li>
						<li>
							<a class="social-btn" href={`mailto:${about.socials.email}`} aria-label="Email">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path
										d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
									></path>
									<polyline points="22,6 12,13 2,6"></polyline>
								</svg>
							</a>
						</li>
					</ul>
				</section>

				<section class="body">
					<h3 class="section-title">
						<span data-lang="en">{about.experienceTitle.en}</span>
						<span data-lang="zh">{about.experienceTitle.zh}</span>
					</h3>
					<dl class="timeline">
						{
							about.experience.map((entry) => (
								<div class="entry">
									<dt>
										<strong>
											<span data-lang="en">{entry.role.en}</span>
											<span data-lang="zh">{entry.role.zh}</span>
										</strong>
										<span class="mono date">{entry.date}</span>
									</dt>
									<dd>
										<span data-lang="en">{entry.desc.en}</span>
										<span data-lang="zh">{entry.desc.zh}</span>
									</dd>
								</div>
							))
						}
					</dl>

					<h3 class="section-title">
						<span data-lang="en">{about.certificationsTitle.en}</span>
						<span data-lang="zh">{about.certificationsTitle.zh}</span>
					</h3>
					<div class="skills">
						{
							about.certifications.map((cert) => (
								<span class="pill">
									<span data-lang="en">{cert.en}</span>
									<span data-lang="zh">{cert.zh}</span>
								</span>
							))
						}
					</div>

					<h3 class="section-title">
						<span data-lang="en">{about.awardsTitle.en}</span>
						<span data-lang="zh">{about.awardsTitle.zh}</span>
					</h3>
					<div class="awards mono">
						{
							about.awards.map((award) => (
								<p>
									<span data-lang="en">{award.en}</span>
									<span data-lang="zh">{award.zh}</span>
								</p>
							))
						}
					</div>

					<h3 class="section-title">
						<span data-lang="en">{about.educationTitle.en}</span>
						<span data-lang="zh">{about.educationTitle.zh}</span>
					</h3>
					<dl class="timeline">
						{
							about.education.map((entry) => (
								<div class="entry">
									<dt>
										<strong>
											<span data-lang="en">{entry.degree.en}</span>
											<span data-lang="zh">{entry.degree.zh}</span>
										</strong>
										{entry.extra && (
											<span>
												<span data-lang="en">{entry.extra.en}</span>
												<span data-lang="zh">{entry.extra.zh}</span>
											</span>
										)}
										<span class="mono date">{entry.date}</span>
									</dt>
								</div>
							))
						}
					</dl>
				</section>
			</div>
		</main>
		<Footer />
		<script>
			const localeBtn = document.querySelector<HTMLButtonElement>('[data-action="about-locale"]');
			if (localeBtn) {
				localeBtn.addEventListener('click', () => {
					const next = document.documentElement.getAttribute('data-locale') === 'zh' ? 'en' : 'zh';
					try {
						localStorage.setItem('tc-locale-about', next);
					} catch (e) {}
					document.dispatchEvent(new CustomEvent('tc-locale-set', { detail: next }));
				});
			}

			const wechatBtn = document.querySelector<HTMLButtonElement>('[data-wechat-id]');
			if (wechatBtn) {
				const labels = { en: 'Copied', 'zh-CN': '已复制' };
				const locale = () =>
					document.documentElement.getAttribute('data-locale') === 'zh' ? 'zh-CN' : 'en';
				const originalTitle = wechatBtn.getAttribute('title') || '';
				wechatBtn.addEventListener('click', async () => {
					const id = wechatBtn.dataset.wechatId;
					if (!id) return;
					try {
						await navigator.clipboard.writeText(id);
					} catch (e) {
						return;
					}
					wechatBtn.setAttribute('data-copied', '');
					wechatBtn.title = labels[locale()] + ': ' + id;
					setTimeout(() => {
						wechatBtn.removeAttribute('data-copied');
						wechatBtn.title = originalTitle;
					}, 2000);
				});
			}
		</script>
		<style>
			main.container {
				padding: 2.5rem 0 4rem;
			}
			.about-grid {
				display: grid;
				grid-template-columns: 280px 1fr;
				gap: 3rem;
			}
			.intro {
				border-right: 1px solid var(--line);
				padding-right: 2.5rem;
			}
			.intro h2 {
				margin-bottom: 0.2rem;
			}
			.locale-btn {
				display: inline-flex;
				align-items: center;
				margin-bottom: 1rem;
				padding: 0.3rem 0.65rem;
				border: 1px solid var(--line-strong);
				border-radius: var(--radius-full);
				background: var(--paper-raise);
				font-size: 11px;
				letter-spacing: 0.12em;
				color: var(--ink-soft);
				cursor: pointer;
				transition:
					color 0.15s ease,
					border-color 0.15s ease;
			}
			.locale-btn:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.bio {
				color: var(--ink-soft);
				font-size: 0.95em;
				margin-bottom: 0.4rem;
			}
			.bio-note {
				margin: 0 0 1.5rem;
				font-size: 12px;
				letter-spacing: 0.06em;
				color: var(--ink-faint);
			}
			.socials {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				gap: 0.55rem;
			}
			.social-btn {
				border: none;
				background: var(--paper-raise);
				cursor: pointer;
				font: inherit;
			}
			.social-btn:hover {
				border-color: var(--accent);
			}
			.body h3 {
				margin-top: 2.2rem;
			}
			.body > h3:first-child {
				margin-top: 0;
			}
			.timeline {
				margin: 0;
			}
			.entry {
				padding: 0.9rem 0;
				border-bottom: 1px dashed var(--line);
			}
			.entry dt {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
			}
			.entry .date {
				flex-shrink: 0;
				margin-left: auto;
				font-size: 12px;
				color: var(--ink-faint);
				letter-spacing: 0.08em;
			}
			.entry dd {
				margin: 0.35rem 0 0;
				color: var(--ink-soft);
				font-size: 0.95em;
			}
			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 0.8rem;
			}
			.awards p {
				margin: 0 0 0.5rem;
				font-size: 12px;
				letter-spacing: 0.06em;
				color: var(--ink-faint);
			}
			@media (max-width: 720px) {
				.about-grid {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.intro {
					border-right: none;
					border-bottom: 1px solid var(--line);
					padding-right: 0;
					padding-bottom: 1.5rem;
				}
			}
		</style>
	</body>
</html>
