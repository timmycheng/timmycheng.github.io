---
// 顶部阅读进度条（借鉴 Publica readbar）：fixed 在页头下缘，随滚动填充
---

<div class="read-progress" aria-hidden="true"></div>

<script>
	const bar = document.querySelector<HTMLElement>('.read-progress');
	if (bar) {
		const header = document.querySelector('.site-header');
		const update = () => {
			const doc = document.documentElement;
			const max = doc.scrollHeight - window.innerHeight;
			const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
			bar.style.transform = `scaleX(${p})`;
			// 页头隐藏时进度条同步上滑贴顶，避免悬在半空
			if (header) {
				bar.classList.toggle('is-detached', header.classList.contains('is-hidden'));
			}
		};
		update();
		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
	}
</script>

<style>
	.read-progress {
		position: fixed;
		top: 59px; /* 页头高度（logo 14px*2 + 30px + 1px 边线） */
		left: 0;
		right: 0;
		height: 2px;
		z-index: 9;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 center;
		pointer-events: none;
		transition: top 0.36s var(--ease-out);
	}
	.read-progress.is-detached {
		top: 0;
	}
</style>
