---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const tiles = [
	{
		no: '01',
		key: 'about',
		label: 'About',
		alt: '关于',
		desc: 'Who I am and what I do',
		href: '/about',
	},
	{
		no: '02',
		key: 'writing',
		label: 'Writing',
		alt: '文章',
		desc: 'Tech notes and essays',
		href: '/blog',
	},
	{
		no: '03',
		key: 'projects',
		label: 'Projects',
		alt: '项目',
		desc: 'Things I have built',
		href: '/projects',
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container">
			<section class="hero">
				<span class="watermark mono" aria-hidden="true">T/</span>
				<div class="hero-main">
					<p class="mono-label">timmycheng.cn — EST.2026</p>
					<h1 class="name">TIMMY<br />CHENG<span class="accent">.</span></h1>
					<p class="lede" data-i18n="hero.lede">
						Security operations engineer. I build detections and automations, write words — this
						site collects what I make and what I think.
					</p>
				</div>
				<div class="console mono">
					<div class="console-bar">
						<span>SYS.CONFIG</span>
						<span class="console-dots">:::</span>
					</div>
					<dl>
						<div class="crow"><dt>ROLE</dt><span class="leader"></span><dd>Security Ops</dd></div>
						<div class="crow"><dt>FOCUS</dt><span class="leader"></span><dd>Detection</dd></div>
						<div class="crow">
							<dt>STACK</dt><span class="leader"></span><dd>Detection / Research</dd>
						</div>
						<div class="crow"><dt>BASE</dt><span class="leader"></span><dd>CN · UTC+8</dd></div>
						<div class="crow">
							<dt>STATUS</dt><span class="leader"></span><dd class="ok">
								<i class="dot"></i>ONLINE
							</dd>
						</div>
					</dl>
				</div>
			</section>

			<section class="tiles" aria-label="Sections">
				{
					tiles.map((t) => (
						<a class="tile" href={t.href}>
							<span class="no mono">{t.no}</span>
							<span class="zh" data-i18n={`nav.${t.key}`}>
								{t.label}
							</span>
							<span class="en mono" data-i18n={`nav.${t.key}.alt`}>
								{t.alt}
							</span>
							<span class="desc" data-i18n={`t.${t.key}.desc`}>
								{t.desc}
							</span>
							<span class="arrow mono">→</span>
						</a>
					))
				}
			</section>

			<section class="latest">
				<div class="latest-head">
					<h2 data-i18n="latest.title">Recent</h2>
					<div class="latest-links">
						<a href="/rss.xml" class="mono more">RSS ↗</a>
						<a href="/blog" class="mono more" data-i18n="latest.all">All →</a>
					</div>
				</div>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="date mono">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="title">{post.data.title}</span>
									<span class="arrow mono">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<style>
			.accent {
				color: var(--accent);
			}
			/* ── hero：左右两列从顶部平行 ── */
			.hero {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto;
				align-items: center;
				gap: 3rem;
				padding: 4.5rem 0 3.5rem;
				overflow: hidden;
			}
			.hero-main {
				position: relative;
				z-index: 1;
			}
			.watermark {
				position: absolute;
				right: -5rem;
				bottom: -7rem;
				font-size: 24rem;
				line-height: 1;
				font-weight: 700;
				color: var(--ink);
				opacity: 0.04;
				pointer-events: none;
				user-select: none;
			}
			.name {
				font-size: clamp(3rem, 8vw, 5.4rem);
				line-height: 0.95;
				letter-spacing: -0.045em;
				margin: 1.1rem 0 1.4rem;
			}
			.lede {
				max-width: 30em;
				margin: 0;
				font-size: 1.06em;
				color: var(--ink-soft);
			}
			/* ── 控制台面板 ── */
			.console {
				position: relative;
				z-index: 1;
				min-width: 250px;
				border: 1px solid var(--line-strong);
				background: var(--paper-raise);
			}
			.console-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 5px 10px;
				background: var(--ink);
				color: var(--paper);
				font-size: 10px;
				letter-spacing: 0.22em;
			}
			.console-dots {
				color: var(--accent);
			}
			.console dl {
				margin: 0;
				padding: 0.35rem 10px;
			}
			.crow {
				display: flex;
				align-items: baseline;
				gap: 0.6rem;
				padding: 0.5rem 0;
				font-size: 12px;
			}
			.crow dt {
				color: var(--ink-faint);
				letter-spacing: 0.12em;
				flex-shrink: 0;
			}
			.leader {
				flex: 1;
				border-bottom: 1px dotted var(--line-strong);
				transform: translateY(-3px);
			}
			.crow dd {
				margin: 0;
				font-weight: 600;
				flex-shrink: 0;
			}
			.crow .ok {
				color: var(--accent);
			}
			.crow .dot {
				display: inline-block;
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--accent);
				margin-right: 6px;
				animation: blink 2.4s ease-in-out infinite;
			}
			@keyframes blink {
				50% {
					opacity: 0.35;
				}
			}
			/* ── tiles：一行三块，悬停反色 ── */
			.tiles {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				background: var(--line-strong);
				border: 1px solid var(--line-strong);
			}
			.tile {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto;
				grid-template-areas:
					'no arrow'
					'zh arrow'
					'en en'
					'desc desc';
				row-gap: 0.2rem;
				column-gap: 1rem;
				padding: 1.5rem 1.4rem 1.4rem;
				background: var(--paper);
				text-decoration: none;
				transition: background 0.18s ease;
			}
			.tile:hover {
				background: var(--ink);
			}
			.tile .no {
				grid-area: no;
				font-size: 12px;
				font-weight: 700;
				color: var(--accent);
			}
			.tile .zh {
				grid-area: zh;
				font-size: 1.45rem;
				font-weight: 800;
				letter-spacing: 0.02em;
				line-height: 1.15;
			}
			.tile .en {
				grid-area: en;
				font-size: 11px;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				color: var(--ink-faint);
			}
			.tile .desc {
				grid-area: desc;
				margin-top: 0.7rem;
				font-size: 0.88em;
				color: var(--ink-soft);
			}
			.tile .arrow {
				grid-area: arrow;
				align-self: start;
				font-size: 16px;
				color: var(--ink-faint);
				transition:
					transform 0.18s ease,
					color 0.18s ease;
			}
			.tile:hover .zh,
			.tile:hover .desc {
				color: var(--paper);
			}
			.tile:hover .en,
			.tile:hover .arrow {
				color: var(--paper-deep);
			}
			.tile:hover .arrow {
				transform: translate(3px, -3px);
				color: var(--accent);
			}
			/* ── latest ── */
			.latest {
				margin-top: 3.5rem;
			}
			.latest-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				border-bottom: 2px solid var(--ink);
				padding-bottom: 0.6rem;
				margin-bottom: 0.5rem;
			}
			.latest-head h2 {
				margin: 0;
				font-size: 1.3em;
			}
			.latest-links {
				display: flex;
				gap: 1.2rem;
			}
			.latest .more {
				font-size: 13px;
				color: var(--ink-soft);
				text-decoration: none;
			}
			.latest .more:hover {
				color: var(--accent);
			}
			.latest ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.latest li {
				border-bottom: 1px solid var(--line);
			}
			.latest a {
				display: grid;
				grid-template-columns: 8.5rem 1fr auto;
				align-items: baseline;
				gap: 1rem;
				padding: 1.4rem 0.5rem;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			.latest a:hover {
				background: var(--paper-raise);
			}
			.latest .date {
				font-size: 12px;
				color: var(--ink-faint);
				letter-spacing: 0.05em;
			}
			.latest .title {
				font-weight: 700;
			}
			.latest a:hover .title {
				color: var(--accent);
			}
			.latest .arrow {
				font-size: 14px;
				color: var(--ink-faint);
			}
			@media (max-width: 720px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 2rem;
					padding: 3rem 0 2.5rem;
				}
				.watermark {
					font-size: 14rem;
					right: -3rem;
					bottom: -4rem;
				}
				.tiles {
					grid-template-columns: 1fr;
				}
				.latest a {
					grid-template-columns: 1fr auto;
				}
				.latest .date {
					grid-column: 1 / -1;
				}
			}
		</style>
	</body>
</html>
