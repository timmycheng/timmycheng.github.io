---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Comments from '../../components/Comments.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ReadProgress from '../../components/ReadProgress.astro';
import ShareRail from '../../components/ShareRail.astro';
import StoryHead from '../../components/StoryHead.astro';
import Toc from '../../components/Toc.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

const project = Astro.props;
const { Content, headings } = await render(project);
const statusLabel = { wip: 'WIP', active: 'ACTIVE', done: 'DONE' } as const;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${project.data.title} · Projects`} description={project.data.description} />
	</head>
	<body>
		<Header />
		<ReadProgress />
		<main id="main-content" class="container prose-wrap">
			<StoryHead
				kicker={project.data.tags[0]}
				title={project.data.title}
				lede={project.data.description}
			>
				<span class:list={['status', project.data.status]}>
					{statusLabel[project.data.status]}
				</span>
				<span><FormattedDate date={project.data.pubDate} /></span>
				{
					project.data.repo && (
						<a href={project.data.repo} target="_blank" rel="noopener">
							[repo]
						</a>
					)
				}
				{
					project.data.link && (
						<a href={project.data.link} target="_blank" rel="noopener">
							[link]
						</a>
					)
				}
			</StoryHead>
			{
				project.data.heroImage && (
					<figure class="hero-image">
						<Image
							src={project.data.heroImage}
							alt=""
							widths={[480, 768, 1200, 1600]}
							sizes="(max-width: 1048px) calc(100vw - 3rem), 1000px"
							loading="eager"
							fetchpriority="high"
						/>
					</figure>
				)
			}
			<div class="post-grid">
				<div class="rail">
					<Toc headings={headings} />
					<ShareRail title={project.data.title} />
				</div>
				<div class="post-main">
					<article>
						<div class="prose">
							<Content />
						</div>
						{
							project.data.tags.length > 0 && (
								<div class="story-tags">
									{project.data.tags.map((t) => (
										<span class="pill">#{t}</span>
									))}
								</div>
							)
						}
						<p class="back">
							<a class="link-sweep" href="/works"
								>← <span data-i18n="post.back">Back to Works</span></a
							>
						</p>
						</article>
						<Comments />
					</div>
			</div>
		</main>
		<Footer />
		<style>
			/* 正文列 + 左侧栏成组居中（借鉴 Publica ≥1024 布局） */
			main.prose-wrap {
				width: auto;
				max-width: none;
				padding: 0 1.5rem 4rem;
			}
			.post-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				align-items: start;
			}
			.rail {
				display: none;
			}
			.post-main {
				min-width: 0;
			}
			.prose {
				max-width: none;
			}
			.prose :global(h2),
			.prose :global(h3) {
				scroll-margin-top: 6rem;
			}
			/* ── 通栏题头图（≥768px 裁成 21:9 电影比例） ── */
			.hero-image {
				width: min(1000px, 100%);
				margin: 0 auto 3rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: var(--radius-md);
				border: 1px solid var(--line-strong);
			}
			@media (min-width: 768px) {
				.hero-image img {
					aspect-ratio: 21 / 9;
					object-fit: cover;
				}
			}
			@media (min-width: 1024px) {
				.post-grid {
					grid-template-columns: 15rem minmax(0, var(--layout-content));
					gap: 2.5rem;
					justify-content: center;
				}
				.rail {
					display: grid;
					gap: 2.25rem;
					width: 15rem;
					position: sticky;
					top: 6rem;
					align-self: start;
				}
				.post-main {
					border-left: 1px solid var(--line);
					padding-left: 1.75rem;
				}
			}
			/* ── 文末标签与返回 ── */
			.story-tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin: 2.75rem 0 0;
				padding-top: 1.6rem;
				border-top: 1px solid var(--line);
			}
			.back {
				margin: 2.5rem 0 0;
				font-size: 13px;
			}
			.back a {
				color: var(--ink-soft);
			}
			.back a:hover {
				color: var(--accent);
			}
			.status {
				font-weight: 700;
				padding: 3px 7px;
				border-radius: 3px;
				color: var(--paper);
				background: var(--ink-faint);
			}
			.status.active {
				background: var(--accent);
			}
			.status.wip {
				background: var(--ink);
			}
			.meta-row a {
				color: var(--ink-soft);
				text-decoration: none;
			}
			.meta-row a:hover {
				color: var(--accent);
			}
		</style>
	</body>
</html>
