---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Comments from '../../components/Comments.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ReadProgress from '../../components/ReadProgress.astro';
import ShareRail from '../../components/ShareRail.astro';
import StoryHead from '../../components/StoryHead.astro';
import Toc from '../../components/Toc.astro';
import { SITE_TITLE } from '../../consts';
import { readingMinutes } from '../../utils/reading';

export async function getStaticPaths() {
	const entries = await getCollection('works');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Heading = { depth: number; slug: string; text: string };

const {
	data: { title, description, pubDate, updatedDate, heroImage, tags = [], repo, link, status },
	id: slug,
	body,
} = Astro.props;
const { Content, headings } = await render(Astro.props);

const statusLabel = { wip: 'WIP', active: 'ACTIVE', done: 'DONE' } as const;
const minutes = readingMinutes(body ?? '');

const related = (await getCollection('works'))
	.filter((p) => p.id !== slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	image: heroImage ? new URL(heroImage.src, Astro.site).href : undefined,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: 'Timmy Cheng' },
	mainEntityOfPage: Astro.url.href,
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${title} · ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>

	<body>
		<Header />
		<ReadProgress />
		<main id="main-content" class="container prose-wrap">
			<StoryHead kicker={tags[0]} title={title} lede={description}>
				{status && <span class:list={['status', status]}>{statusLabel[status]}</span>}
				<span>
					<FormattedDate date={pubDate} />
				</span>
				<span class="read">
					<span class="num">{minutes}</span>
					<span data-i18n="read.min">min read</span>
				</span>
				{
					updatedDate && (
						<span class="updated">
							updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
				{
					repo && (
						<a href={repo} target="_blank" rel="noopener">
							[repo]
						</a>
					)
				}
				{
					link && (
						<a href={link} target="_blank" rel="noopener">
							[link]
						</a>
					)
				}
			</StoryHead>
			{
				heroImage && (
					<figure class="hero-image">
						<Image
							src={heroImage}
							alt=""
							widths={[480, 768, 1200, 1600]}
							sizes="(max-width: 1048px) calc(100vw - 3rem), 1000px"
							loading="eager"
							fetchpriority="high"
						/>
					</figure>
				)
			}
			<div class="post-grid">
				<div class="rail">
					<Toc headings={headings} />
					<ShareRail title={title} />
				</div>
				<div class="post-main">
					<article>
						<div class="prose">
							<Content />
						</div>
						{
							tags.length > 0 && (
								<div class="story-tags">
									{tags.map((t) => (
										<a class="pill" href="/works">
											#{t}
										</a>
									))}
								</div>
							)
						}
						{
							related.length > 0 && (
								<section class="related">
									<h2 class="section-title">
										<span data-i18n="related.title">Related posts</span>
									</h2>
									<div class="feed">
										{related.map((p) => (
											<article class="feed-card compact">
												<a class="title-link" href={`/works/${p.id}/`}>
													<div class="meta-row">
														<span>
															<FormattedDate date={p.data.pubDate} />
														</span>
														<span class="read">
															<span class="num">{readingMinutes(p.body ?? '')}</span>{' '}
															<span data-i18n="read.min">min read</span>
														</span>
													</div>
													<h3 class="title">{p.data.title}</h3>
													<p class="excerpt">{p.data.description}</p>
												</a>
											</article>
										))}
									</div>
								</section>
							)
						}
						<p class="back">
							<a class="link-sweep" href="/works"
								>← <span data-i18n="post.back">Back to Works</span></a
							>
						</p>
						<Comments />
					</article>
				</div>
			</div>
		</main>
		<Footer />
		<style>
			/* 正文列 + 左侧栏成组居中（借鉴 Publica ≥1024 布局） */
			main.prose-wrap {
				width: auto;
				max-width: none;
				padding: 0 1.5rem 4rem;
			}
			.post-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				align-items: start;
			}
			.rail {
				display: none;
			}
			.post-main {
				min-width: 0;
			}
			.prose {
				max-width: none;
			}
			.prose :global(h2),
			.prose :global(h3) {
				scroll-margin-top: 6rem;
			}
			/* ── 通栏题头图（≥768px 裁成 21:9 电影比例） ── */
			.hero-image {
				width: min(1000px, 100%);
				margin: 0 auto 3rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: var(--radius-md);
				border: 1px solid var(--line-strong);
			}
			@media (min-width: 768px) {
				.hero-image img {
					aspect-ratio: 21 / 9;
					object-fit: cover;
				}
			}
			@media (min-width: 1024px) {
				.post-grid {
					grid-template-columns: 15rem minmax(0, var(--layout-content));
					gap: 2.5rem;
					justify-content: center;
				}
				.rail {
					display: grid;
					gap: 2.25rem;
					width: 15rem;
					position: sticky;
					top: 6rem;
					align-self: start;
				}
				.post-main {
					border-left: 1px solid var(--line);
					padding-left: 1.75rem;
				}
			}
			.meta-row .updated {
				color: var(--ink-faint);
			}
			.meta-row a {
				color: var(--ink-soft);
				text-decoration: none;
			}
			.meta-row a:hover {
				color: var(--accent);
			}
			.status {
				font-weight: 700;
				padding: 3px 7px;
				border-radius: 3px;
				color: var(--paper);
				background: var(--ink-faint);
			}
			.status.active {
				background: var(--accent);
			}
			.status.wip {
				background: var(--ink);
			}
			/* ── 文末标签 ── */
			.story-tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin: 2.75rem 0 0;
				padding-top: 1.6rem;
				border-top: 1px solid var(--line);
			}
			.related {
				margin-top: 3.5rem;
			}
			.related .feed {
				gap: 2.25rem;
			}
			.back {
				margin: 2.5rem 0 0;
				font-size: 13px;
			}
			.back a {
				color: var(--ink-soft);
			}
			.back a:hover {
				color: var(--accent);
			}
		</style>
	</body>
</html>
