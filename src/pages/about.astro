---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`About · ${SITE_TITLE}`}
			description="About Timmy Cheng — security operations engineer, focused on detection and response."
		/>
	</head>
	<body>
		<Header />
		<main class="container">
			<div class="section-head">
				<span class="no">01</span>
				<h1 data-i18n="nav.about">About</h1>
				<span class="en mono-label" data-i18n="nav.about.alt">关于</span>
			</div>

			<div class="about-grid">
				<section class="intro">
					<h2>Timmy Cheng</h2>
					<p class="mono-label">Security Operations Engineer</p>
					<p class="bio" data-i18n="about.bio">
						Security operations engineer focused on SOC operations, detection and response. I
						believe security is operated continuously, not won in a single engagement. I write code
						and words, and take the occasional photo — this site is my little corner.
					</p>
					<ul class="contacts mono">
						<li>
							<span class="k">EMAIL</span>
							<span class="todo" data-i18n="about.todo">TBD</span>
						</li>
						<li>
							<span class="k">GITHUB</span>
							<a href="https://github.com/timmycheng">github.com/timmycheng</a>
						</li>
						<li><span class="k">SITE</span> <a href="/">timmycheng.cn</a></li>
					</ul>
				</section>

				<section class="body">
					<h3 class="mono-label" data-i18n="about.exp">Experience / 经历</h3>
					<dl class="timeline">
						<div class="entry">
							<dt>
								<strong data-i18n="about.exp.1.title"
									>Company A — Security Operations Engineer</strong
								>
								<span class="mono date">2024 — NOW</span>
							</dt>
							<dd data-i18n="about.exp.1.desc">
								<!-- TODO: 替换为真实经历 -->
								Placeholder: daily SOC operations, alert triage, and detection rule maintenance.
							</dd>
						</div>
						<div class="entry">
							<dt>
								<strong data-i18n="about.exp.2.title">Company B — Security Engineer</strong>
								<span class="mono date">2021 — 2024</span>
							</dt>
							<dd data-i18n="about.exp.2.desc">
								<!-- TODO: 替换为真实经历 -->
								Placeholder: log platform engineering and incident response.
							</dd>
						</div>
					</dl>

					<h3 class="mono-label" data-i18n="about.skills">Skills / 技能</h3>
					<div class="skills">
						<span class="pill" data-i18n="about.skill.1">SOC operations</span>
						<span class="pill" data-i18n="about.skill.2">SIEM / detection rules</span>
						<span class="pill" data-i18n="about.skill.3">Alert triage</span>
						<span class="pill" data-i18n="about.skill.4">Incident response</span>
						<span class="pill" data-i18n="about.skill.5">Threat intelligence</span>
						<span class="pill" data-i18n="about.skill.6">MITRE ATT&amp;CK</span>
						<span class="pill" data-i18n="about.skill.7">SOAR automation</span>
						<span class="pill" data-i18n="about.skill.8">Python</span>
						<span class="pill" data-i18n="about.skill.9">Log analysis</span>
						<span class="pill todo" data-i18n="about.skills.more">+ more</span>
					</div>

					<h3 class="mono-label" data-i18n="about.edu">Education / 教育</h3>
					<dl class="timeline">
						<div class="entry">
							<dt>
								<strong data-i18n="about.edu.1.title">Some University — Some Major</strong>
								<span class="mono date">2017 — 2021</span>
							</dt>
							<dd data-i18n="about.edu.1.desc">Placeholder description.</dd>
						</div>
					</dl>
				</section>
			</div>
		</main>
		<Footer />
		<style>
			main.container {
				padding: 0;
			}
			.about-grid {
				display: grid;
				grid-template-columns: 280px 1fr;
				gap: 3rem;
			}
			.intro {
				border-right: 1px solid var(--line);
				padding-right: 2.5rem;
			}
			.intro h2 {
				margin-bottom: 0.2rem;
			}
			.bio {
				color: var(--ink-soft);
				font-size: 0.95em;
			}
			.contacts {
				list-style: none;
				margin: 1.5rem 0 0;
				padding: 0;
				display: grid;
				gap: 0.6rem;
				font-size: 13px;
			}
			.contacts .k {
				display: inline-block;
				width: 4.2rem;
				color: var(--ink-faint);
				letter-spacing: 0.1em;
			}
			.contacts a {
				color: var(--ink-soft);
			}
			.body h3 {
				margin-top: 2.2rem;
			}
			.body > h3:first-child {
				margin-top: 0;
			}
			.timeline {
				margin: 0;
			}
			.entry {
				padding: 0.9rem 0;
				border-bottom: 1px dashed var(--line);
			}
			.entry dt {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
			}
			.entry .date {
				flex-shrink: 0;
				font-size: 12px;
				color: var(--ink-faint);
				letter-spacing: 0.08em;
			}
			.entry dd {
				margin: 0.35rem 0 0;
				color: var(--ink-soft);
				font-size: 0.95em;
			}
			.skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 0.8rem;
			}
			@media (max-width: 720px) {
				.about-grid {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.intro {
					border-right: none;
					border-bottom: 1px solid var(--line);
					padding-right: 0;
					padding-bottom: 1.5rem;
				}
			}
		</style>
	</body>
</html>
