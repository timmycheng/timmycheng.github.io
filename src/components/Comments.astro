---
// giscus 评论组件 — 数据存于 GitHub Discussions
// 前置：仓库已开 Discussions；需安装 giscus app: https://github.com/apps/giscus
// 主题/语言跟随站点明暗与中英切换（postMessage setConfig）
---

<section class="comments">
	<link rel="preconnect" href="https://giscus.app" />
	<div class="comments-head">
		<h2 class="mono-label" data-i18n="comments.title">Comments</h2>
	</div>
	<div class="giscus-mount"></div>
</section>

<script is:inline>
	(function () {
		var mount = document.currentScript.parentElement.querySelector('.giscus-mount');
		var d = document.documentElement;
		// 运行时取当前 origin：生产与本地预览均可加载自定义主题 CSS
		var BASE = location.origin;
		var THEME_LIGHT = BASE + '/giscus-theme.css';
		var THEME_DARK = BASE + '/giscus-theme-dark.css';

		function themeUrl() {
			return d.getAttribute('data-theme') === 'dark' ? THEME_DARK : THEME_LIGHT;
		}
		function lang() {
			return d.getAttribute('data-locale') === 'en' ? 'en' : 'zh-CN';
		}

		function inject() {
			var old = mount.querySelector('script');
			if (old) old.remove();
			var s = document.createElement('script');
			s.src = 'https://giscus.app/client.js';
			s.setAttribute('data-repo', 'timmycheng/timmycheng.github.io');
			s.setAttribute('data-repo-id', 'MDEwOlJlcG9zaXRvcnk0MDM5MDYzNTM=');
			s.setAttribute('data-category', 'Announcements');
			s.setAttribute('data-category-id', 'DIC_kwDOGBMfMc4DENaE');
			s.setAttribute('data-mapping', 'pathname');
			s.setAttribute('data-strict', '0');
			s.setAttribute('data-reactions-enabled', '1');
			s.setAttribute('data-emit-metadata', '0');
			s.setAttribute('data-input-position', 'top');
			s.setAttribute('data-theme', themeUrl());
			s.setAttribute('data-lang', lang());
			s.setAttribute('data-loading', 'lazy');
			s.crossOrigin = 'anonymous';
			s.async = true;
			mount.appendChild(s);
		}

		function sync() {
			var iframe = mount.querySelector('iframe.giscus-frame');
			if (iframe && iframe.contentWindow) {
				iframe.contentWindow.postMessage(
					{ giscus: { setConfig: { theme: themeUrl(), lang: lang() } } },
					'https://giscus.app',
				);
			}
		}

		inject();
		document.addEventListener('tc-theme-change', sync);
		document.addEventListener('tc-locale-change', function () {
			sync();
		});
	})();
</script>

<style>
	.comments {
		margin-top: 3.5rem;
		padding-top: 1.8rem;
		border-top: 1px solid var(--line-strong);
	}
</style>
