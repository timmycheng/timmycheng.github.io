---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

const project = Astro.props;
const { Content } = await render(project);
const statusLabel = { wip: 'WIP', active: 'ACTIVE', done: 'DONE' } as const;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${project.data.title} · 项目`} description={project.data.description} />
	</head>
	<body>
		<Header />
		<main class="container prose-wrap">
			<article>
				<header class="head">
					<p class="mono-label"><a href="/projects">← 项目</a></p>
					<h1>{project.data.title}</h1>
					<div class="meta mono">
						<span class:list={['status', project.data.status]}>
							{statusLabel[project.data.status]}
						</span>
						<span><FormattedDate date={project.data.pubDate} /></span>
						{
							project.data.repo && (
								<a href={project.data.repo} target="_blank">
									[repo]
								</a>
							)
						}
						{
							project.data.link && (
								<a href={project.data.link} target="_blank">
									[link]
								</a>
							)
						}
					</div>
					<div class="tags">
						{project.data.tags.map((t) => <span class="pill">{t}</span>)}
					</div>
				</header>
				<div class="prose">
					<Content />
				</div>
			</article>
		</main>
		<Footer />
		<style>
			.head {
				padding: 2.5rem 0 1.8rem;
				border-bottom: 2px solid var(--ink);
				margin-bottom: 2.5rem;
			}
			.head a {
				color: var(--ink-soft);
				text-decoration: none;
				font-size: 12px;
			}
			.head a:hover {
				color: var(--accent);
			}
			.head h1 {
				font-size: clamp(1.8rem, 4.5vw, 2.6rem);
				margin: 0.8rem 0 1rem;
			}
			.meta {
				display: flex;
				gap: 1.2rem;
				align-items: center;
				flex-wrap: wrap;
				font-size: 12px;
				letter-spacing: 0.08em;
				color: var(--ink-faint);
			}
			.meta a {
				color: var(--ink-soft);
				text-decoration: none;
			}
			.meta a:hover {
				color: var(--accent);
			}
			.status {
				font-weight: 700;
				padding: 3px 7px;
				border-radius: 3px;
				color: var(--paper);
				background: var(--ink-faint);
			}
			.status.active {
				background: var(--accent);
			}
			.status.wip {
				background: var(--ink);
			}
			.tags {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
				margin-top: 1rem;
			}
			.prose {
				max-width: 44rem;
			}
			.prose :global(h2) {
				margin-top: 2.4em;
				padding-left: 0.8rem;
				border-left: 4px solid var(--accent);
			}
		</style>
	</body>
</html>
