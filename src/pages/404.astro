---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`404 · ${SITE_TITLE}`} description="Page not found." />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container err">
			<p class="mono-label" data-i18n="err.code">SYS.ERR / 404</p>
			<h1 class="code">404</h1>
			<p class="lede" data-i18n="err.title">Page not found — 页面未找到</p>
			<a href="/" class="btn btn-solid home-btn" data-i18n="err.home">← HOME</a>
		</main>
		<Footer />
		<style>
			.err {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				min-height: 60vh;
				padding-block: 3rem 5rem;
			}
			.code {
				font-family: var(--font-mono);
				font-size: clamp(6rem, 18vw, 11rem);
				font-weight: 900;
				line-height: 1;
				letter-spacing: 0.02em;
				margin: 0.8rem 0 0.6rem;
			}
			.lede {
				font-size: 1.05em;
				color: var(--ink-soft);
			}
			.home-btn {
				margin-top: 2rem;
			}
		</style>
	</body>
</html>
