---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	publishedTime?: Date;
	modifiedTime?: Date;
}

const { title, description, image, publishedTime, modifiedTime } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogType = publishedTime ? 'article' : 'website';
---

<!-- 主题与语言无闪初始化 + i18n 文本替换 -->
<script is:inline>
	(function () {
		var d = document.documentElement;
		var theme = null;
		var locale = null;
		try {
			theme = localStorage.getItem('tc-theme');
			locale = localStorage.getItem('tc-locale2');
		} catch (e) {}
		if (!theme)
			theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		if (locale !== 'zh') locale = 'en';
		d.setAttribute('data-theme', theme);
		d.setAttribute('data-locale', locale);
		d.lang = locale === 'en' ? 'en' : 'zh-CN';

		var I18N = {
			zh: {
				'nav.about': '关于',
				'nav.works': '作品',
				'nav.about.alt': 'ABOUT',
				'nav.works.alt': 'WORKS',
				'hero.lede':
					'安全运营工程师。做检测、写自动化、写文字——这个网站收集我做出的东西和写下的想法。',
				't.about.desc': '我是谁，在做什么',
				't.works.desc': '文章与项目',
				'latest.title': '最近文章',
				'latest.all': '全部 →',
				'home.sections': '栏目',
				'read.min': '分钟',
				'works.title': '作品 / Works',
				'works.sub': '文章与项目——写下的文字与做出来的东西。',
				'works.items': '项',
				'works.all': '全部',
				'works.empty': '没有匹配这个标签的内容。',
				'toc.title': '目录',
				'related.title': '相关阅读',
				'post.share': '分享',
				'post.copy': '复制链接',
				'post.back': '返回作品',
				'about.bio': '专注网络安全运营。',
				'about.resume.ask': '如果有兴趣，可以找我拿简历。',
				'about.wechat.copied': '微信号已复制',
				'about.exp': '经历 / Experience',
				'about.edu': '教育 / Education',
				'about.certs': '认证 / Certifications',
				'about.awards': '荣誉 / Awards',
				'about.award.1': '省市网络安全技能竞赛 金/银/铜奖多项（2015—2020）',
				'about.award.2':
					'市级网络安全应急响应专家组成员（2019）；网络安全与数据安全专家（2024—至今）',
				'about.exp.1.role': '网络安全运营',
				'about.exp.1.desc': '银行系统与应用的安全运营与管理。',
				'about.exp.2.role': '安全产品经理 / 咨询工程师',
				'about.exp.2.desc': '安全运营平台产品的打造、安全咨询与国家标准。',
				'about.exp.3.role': '网络安全工程师',
				'about.exp.3.desc': '安全设备运营、漏洞管理、平台建设、培训与竞赛。',
				'about.edu.1.degree': '计算机信息系统 硕士',
				'about.edu.1.extra': '（在读）',
				'about.edu.2.degree': '计算机科学 本科',
				'about.cert.1': 'CISSP · 2018',
				'about.cert.2': 'CISP · 2019',
				'about.cert.3': 'CISP-CSE · 2021',
				'about.cert.4': 'CCSC 云安全 · 2022',
				'about.cert.5': '数据库系统工程师 · 2013',
				'badge.post': '文章',
				'badge.project': '项目',
				featured: '精选',
				'post.read': '阅读',
				'err.code': 'SYS.ERR / 404',
				'err.title': '页面未找到 — Page not found',
				'err.code500': 'SYS.ERR / 500',
				'err.title500': '出了点问题 — Something went wrong',
				'err.home': '← 首页',
				'comments.title': '评论 / Comments',
			},
			en: {
				'nav.about': 'About',
				'nav.works': 'Works',
				'nav.about.alt': '关于',
				'nav.works.alt': '作品',
				'hero.lede':
					'Security operations engineer. I build detections and automations, write words — this site collects what I make and what I think.',
				't.about.desc': 'Who I am and what I do',
				't.works.desc': 'Posts and projects',
				'latest.title': 'Recent',
				'latest.all': 'All →',
				'home.sections': 'Sections',
				'read.min': 'min read',
				'works.title': 'Works / 作品',
				'works.sub': 'Posts and projects — the words I write and the things I build.',
				'works.items': 'items',
				'works.all': 'All',
				'works.empty': 'No items match this tag.',
				'toc.title': 'Contents',
				'related.title': 'Related posts',
				'post.share': 'Share',
				'post.copy': 'Copy link',
				'post.back': 'Back to Works',
				'about.bio': 'Focused on cybersecurity operations.',
				'about.resume.ask': "If you're interested, ask for my resume.",
				'about.wechat.copied': 'WeChat ID copied',
				'about.exp': 'Experience / 经历',
				'about.edu': 'Education / 教育',
				'about.certs': 'Certifications / 认证',
				'about.awards': 'Awards / 荣誉',
				'about.award.1':
					'Multiple gold / silver / bronze prizes in provincial & municipal cyber security skills competitions (2015—2020)',
				'about.award.2':
					'Municipal cybersecurity incident response expert team member (2019); cybersecurity & data security expert (2024—now)',
				'about.exp.1.role': 'Cybersecurity Management',
				'about.exp.1.desc': 'Security operations and management of bank systems and applications.',
				'about.exp.2.role': 'Security Product Manager / Consulting Engineer',
				'about.exp.2.desc':
					'SOC platform product, security consulting, national operating standard.',
				'about.exp.3.role': 'Cybersecurity Engineer',
				'about.exp.3.desc':
					'Security device operations, vulnerability management, platform building, training.',
				'about.edu.1.degree': 'M.S. Computer Information Systems',
				'about.edu.1.extra': ' (in progress)',
				'about.edu.2.degree': 'B.S. Computer Science',
				'about.cert.1': 'CISSP · 2018',
				'about.cert.2': 'CISP · 2019',
				'about.cert.3': 'CISP-CSE · 2021',
				'about.cert.4': 'CCSC Cloud Security · 2022',
				'about.cert.5': 'Database System Engineer · 2013',
				'badge.post': 'ARTICLE',
				'badge.project': 'PROJECT',
				featured: 'FEATURED',
				'post.read': 'Read',
				'err.code': 'SYS.ERR / 404',
				'err.title': 'Page not found — 页面未找到',
				'err.code500': 'SYS.ERR / 500',
				'err.title500': 'Something went wrong — 出了点问题',
				'err.home': '← HOME',
				'comments.title': 'Comments',
			},
		};

		function applyLocale() {
			var dict = I18N[d.getAttribute('data-locale')] || {};
			document.querySelectorAll('[data-i18n]').forEach(function (el) {
				var v = dict[el.getAttribute('data-i18n')];
				if (v != null) el.textContent = v;
			});
		}

		// 局部页面语言切换钩子（about 页使用，不影响其他页面）
		document.addEventListener('tc-locale-set', function (e) {
			var v = e.detail === 'zh' ? 'zh' : 'en';
			d.setAttribute('data-locale', v);
			d.lang = v === 'en' ? 'en' : 'zh-CN';
			applyLocale();
		});

		document.addEventListener('DOMContentLoaded', function () {
			applyLocale();
			document.querySelectorAll('[data-action="theme"]').forEach(function (btn) {
				btn.addEventListener('click', function () {
					var next = d.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					d.setAttribute('data-theme', next);
					try {
						localStorage.setItem('tc-theme', next);
					} catch (e) {}
					document.dispatchEvent(new CustomEvent('tc-theme-change', { detail: next }));
				});
			});
			document.querySelectorAll('[data-action="locale"]').forEach(function (btn) {
				btn.addEventListener('click', function () {
					var next = d.getAttribute('data-locale') === 'zh' ? 'en' : 'zh';
					d.setAttribute('data-locale', next);
					d.lang = next === 'en' ? 'en' : 'zh-CN';
					try {
						localStorage.setItem('tc-locale2', next);
					} catch (e) {}
					applyLocale();
					document.dispatchEvent(new CustomEvent('tc-locale-change', { detail: next }));
				});
			});
		});
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{image && <meta name="twitter:image" content={new URL(image.src, Astro.url)} />}

<!-- Mobile browser chrome color -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0efeb" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171410" />
