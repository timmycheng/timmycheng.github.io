---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

// 自托管字体：英文 Space Grotesk（可变字重）、代码 JetBrains Mono（可变字重），
// 中文 MiSans（unicode-range 分片按需加载）
// MiSans 的字重声明是小米自家的标尺（Light=250、Medium=380、Bold=630），
// 页面请求 400 时按 CSS 匹配规则命中 Medium，请求 600-900 命中 Bold，引用块 300 命中 Light
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import 'misans/lib/Normal/MiSans-Light.min.css';
import 'misans/lib/Normal/MiSans-Medium.min.css';
import 'misans/lib/Normal/MiSans-Bold.min.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	publishedTime?: Date;
	modifiedTime?: Date;
}

const { title, description, image, publishedTime, modifiedTime } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogType = publishedTime ? 'article' : 'website';
---

<!-- 主题与语言无闪初始化 + i18n 文本替换 -->
<script is:inline>
	(function () {
		var d = document.documentElement;
		var theme = null;
		var locale = null;
		try {
			theme = localStorage.getItem('tc-theme');
			locale = localStorage.getItem('tc-locale2');
		} catch (e) {}
		if (!theme)
			theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		if (locale !== 'zh') locale = 'en';
		d.setAttribute('data-theme', theme);
		d.setAttribute('data-locale', locale);
		d.lang = locale === 'en' ? 'en' : 'zh-CN';

		var I18N = {
			zh: {
				'nav.about': '关于',
				'nav.works': '作品',
				'nav.about.alt': 'ABOUT',
				'nav.works.alt': 'WORKS',
				'hero.lede':
					'安全运营工程师。做检测、写自动化、写文字——这个网站收集我做出的东西和写下的想法。',
				't.about.desc': '我是谁，在做什么',
				't.works.desc': '文章与项目',
				'latest.title': '最近文章',
				'latest.all': '全部 →',
				'home.sections': '栏目',
				'read.min': '分钟',
				'works.title': '作品 / Works',
				'works.sub': '文章与项目——写下的文字与做出来的东西。',
				'works.items': '项',
				'works.all': '全部',
				'works.empty': '没有匹配这个标签的内容。',
				'toc.title': '本文目录',
				'related.title': '相关阅读',
				'post.share': '分享',
				'post.copy': '复制链接',
				'post.back': '返回作品',
				'badge.post': '文章',
				'badge.project': '项目',
				featured: '精选',
				'post.read': '阅读',
				'err.code': 'SYS.ERR / 404',
				'err.title': '页面未找到 — Page not found',
				'err.code500': 'SYS.ERR / 500',
				'err.title500': '出了点问题 — Something went wrong',
				'err.home': '← 首页',
				'comments.title': '评论 / Comments',
			},
			en: {
				'nav.about': 'About',
				'nav.works': 'Works',
				'nav.about.alt': '关于',
				'nav.works.alt': '作品',
				'hero.lede':
					'Security operations engineer. I build detections and automations, write words — this site collects what I make and what I think.',
				't.about.desc': 'Who I am and what I do',
				't.works.desc': 'Posts and projects',
				'latest.title': 'Recent',
				'latest.all': 'All →',
				'home.sections': 'Sections',
				'read.min': 'min read',
				'works.title': 'Works / 作品',
				'works.sub': 'Posts and projects — the words I write and the things I build.',
				'works.items': 'items',
				'works.all': 'All',
				'works.empty': 'No items match this tag.',
				'toc.title': 'In this story',
				'related.title': 'Related posts',
				'post.share': 'Share',
				'post.copy': 'Copy link',
				'post.back': 'Back to Works',
				'badge.post': 'ARTICLE',
				'badge.project': 'PROJECT',
				featured: 'FEATURED',
				'post.read': 'Read',
				'err.code': 'SYS.ERR / 404',
				'err.title': 'Page not found — 页面未找到',
				'err.code500': 'SYS.ERR / 500',
				'err.title500': 'Something went wrong — 出了点问题',
				'err.home': '← HOME',
				'comments.title': 'Comments',
			},
		};

		function applyLocale() {
			var dict = I18N[d.getAttribute('data-locale')] || {};
			document.querySelectorAll('[data-i18n]').forEach(function (el) {
				var v = dict[el.getAttribute('data-i18n')];
				if (v != null) el.textContent = v;
			});
		}

		// 局部页面语言切换钩子（about 页使用，不影响其他页面）
		document.addEventListener('tc-locale-set', function (e) {
			var v = e.detail === 'zh' ? 'zh' : 'en';
			d.setAttribute('data-locale', v);
			d.lang = v === 'en' ? 'en' : 'zh-CN';
			applyLocale();
		});

		document.addEventListener('DOMContentLoaded', function () {
			applyLocale();
			document.querySelectorAll('[data-action="theme"]').forEach(function (btn) {
				btn.addEventListener('click', function () {
					var next = d.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					d.setAttribute('data-theme', next);
					try {
						localStorage.setItem('tc-theme', next);
					} catch (e) {}
					document.dispatchEvent(new CustomEvent('tc-theme-change', { detail: next }));
				});
			});
			document.querySelectorAll('[data-action="locale"]').forEach(function (btn) {
				btn.addEventListener('click', function () {
					var next = d.getAttribute('data-locale') === 'zh' ? 'en' : 'zh';
					d.setAttribute('data-locale', next);
					d.lang = next === 'en' ? 'en' : 'zh-CN';
					try {
						localStorage.setItem('tc-locale2', next);
					} catch (e) {}
					applyLocale();
					document.dispatchEvent(new CustomEvent('tc-locale-change', { detail: next }));
				});
			});
		});
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{image && <meta name="twitter:image" content={new URL(image.src, Astro.url)} />}

<!-- Mobile browser chrome color -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0efeb" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171410" />
