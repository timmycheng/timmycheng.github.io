---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

const project = Astro.props;
const { Content } = await render(project);
const statusLabel = { wip: 'WIP', active: 'ACTIVE', done: 'DONE' } as const;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${project.data.title} · Projects`} description={project.data.description} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container prose-wrap">
			<article>
				<header class="head">
					<p class="eyebrow">
						<a class="link-sweep" href="/works">← <span data-i18n="nav.works">Works</span></a>
					</p>
					<h1>{project.data.title}</h1>
					<div class="meta-row">
						<span class:list={['status', project.data.status]}>
							{statusLabel[project.data.status]}
						</span>
						<span><FormattedDate date={project.data.pubDate} /></span>
						{
							project.data.repo && (
								<a href={project.data.repo} target="_blank" rel="noopener">
									[repo]
								</a>
							)
						}
						{
							project.data.link && (
								<a href={project.data.link} target="_blank" rel="noopener">
									[link]
								</a>
							)
						}
					</div>
					{
						project.data.tags.length > 0 && (
							<div class="tags">
								{project.data.tags.map((t) => (
									<span class="pill">{t}</span>
								))}
							</div>
						)
					}
				</header>
				<div class="prose">
					<Content />
				</div>
			</article>
		</main>
		<Footer />
		<style>
			main.prose-wrap {
				padding: 0 0 4rem;
			}
			main.prose-wrap article {
				max-width: var(--layout-content);
				margin-inline: auto;
			}
			.head {
				padding: 2.5rem 0 1.8rem;
				border-bottom: 2px solid var(--ink);
				margin-bottom: 2.5rem;
			}
			.head .eyebrow a {
				color: var(--ink-soft);
			}
			.head .eyebrow a:hover {
				color: var(--accent);
			}
			.head h1 {
				font-size: clamp(1.8rem, 4.5vw, 2.6rem);
				letter-spacing: -0.03em;
				margin: 0.8rem 0 1rem;
			}
			.meta-row {
				font-size: 12px;
			}
			.meta-row a {
				color: var(--ink-soft);
				text-decoration: none;
			}
			.meta-row a:hover {
				color: var(--accent);
			}
			.status {
				font-weight: 700;
				padding: 3px 7px;
				border-radius: 3px;
				color: var(--paper);
				background: var(--ink-faint);
			}
			.status.active {
				background: var(--accent);
			}
			.status.wip {
				background: var(--ink);
			}
			.tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-top: 1rem;
			}
			.prose {
				max-width: none;
			}
		</style>
	</body>
</html>
