.page {
	padding: 32rpx 32rpx 64rpx;
}

.hero {
	width: 100%;
	border-radius: 16rpx;
	margin-bottom: 28rpx;
}

.meta {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 12rpx;
	margin-bottom: 18rpx;
}

.date {
	font-size: 22rpx;
	color: #8a8578;
}

.title-row {
	display: flex;
	align-items: flex-start;
	gap: 20rpx;
}

.title {
	flex: 1;
	font-size: 42rpx;
	font-weight: 700;
	line-height: 1.4;
	color: #191919;
}

.lang-btn {
	flex-shrink: 0;
	font-size: 24rpx;
	font-weight: 600;
	padding: 6rpx 22rpx;
	margin-top: 6rpx;
	border-radius: 999rpx;
	color: #f7f5f0;
	background: #191919;
}

.desc {
	margin: 16rpx 0 8rpx;
	padding-bottom: 24rpx;
	font-size: 27rpx;
	color: #6b6659;
	border-bottom: 1rpx solid #e2ddd1;
}

.tags {
	margin-top: 32rpx;
	display: flex;
	flex-wrap: wrap;
	gap: 16rpx;
}

.tag {
	font-size: 22rpx;
	color: #a0522d;
}

.actions {
	margin-top: 36rpx;
	padding-top: 28rpx;
	border-top: 1rpx solid #e2ddd1;
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.action {
	font-size: 26rpx;
	color: #191919;
	text-align: center;
	padding: 18rpx 0;
	border: 1rpx solid #191919;
	border-radius: 10rpx;
}
