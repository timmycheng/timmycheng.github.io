---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container">
			<section class="hero crosshair">
				<p class="mono-label">Timmy Cheng — timmycheng.cn</p>
				<h1>
					构建工具，<br />记录想法，<span class="accent">收集光。</span>
				</h1>
				<p class="lede">
					软件工程师。这里放我的简历、写的文章、做过的项目，还有一些按快门拍下的东西。
				</p>
				<div class="hero-meta mono">
					<span>LOC — CN</span>
					<span>STATUS — <em class="accent">ONLINE</em></span>
					<span>VER — 2026.08</span>
				</div>
			</section>

			<section class="index">
				<div class="section-head">
					<span class="no">00</span>
					<h2>索引</h2>
					<span class="en mono-label">Index</span>
				</div>
				<ol>
					<li>
						<a href="/resume">
							<span class="no mono">01</span>
							<span class="zh">简历</span>
							<span class="en">Resume</span>
							<span class="desc">我是谁、做过什么、擅长什么</span>
							<span class="arrow">→</span>
						</a>
					</li>
					<li>
						<a href="/blog">
							<span class="no mono">02</span>
							<span class="zh">文章</span>
							<span class="en">Writing</span>
							<span class="desc">技术笔记与随想</span>
							<span class="arrow">→</span>
						</a>
					</li>
					<li>
						<a href="/projects">
							<span class="no mono">03</span>
							<span class="zh">项目</span>
							<span class="en">Projects</span>
							<span class="desc">正在做和已经做完的东西</span>
							<span class="arrow">→</span>
						</a>
					</li>
					<li>
						<a href="/gallery">
							<span class="no mono">04</span>
							<span class="zh">画廊</span>
							<span class="en">Gallery</span>
							<span class="desc">摄影与视觉碎片</span>
							<span class="arrow">→</span>
						</a>
					</li>
				</ol>
			</section>
		</main>
		<Footer />
		<style>
			.accent {
				color: var(--accent);
			}
			.hero {
				padding: 5rem 0 3.5rem;
			}
			.hero h1 {
				font-size: clamp(2.2rem, 6vw, 3.6rem);
				line-height: 1.12;
				margin: 1.2rem 0 1.4rem;
			}
			.lede {
				max-width: 34em;
				font-size: 1.08em;
				color: var(--ink-soft);
			}
			.hero-meta {
				display: flex;
				gap: 2rem;
				flex-wrap: wrap;
				margin-top: 2.2rem;
				font-size: 12px;
				letter-spacing: 0.12em;
				color: var(--ink-faint);
			}
			.hero-meta em {
				font-style: normal;
				font-weight: 700;
			}
			.crosshair {
				position: relative;
			}
			.crosshair::before,
			.crosshair::after {
				content: '+';
				position: absolute;
				font-family: var(--font-mono);
				font-size: 14px;
				color: var(--ink-faint);
				line-height: 1;
			}
			.crosshair::before {
				top: 0;
				left: -18px;
			}
			.crosshair::after {
				bottom: 0;
				right: -18px;
			}
			.index ol {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--line);
			}
			.index li {
				border-bottom: 1px solid var(--line);
			}
			.index a {
				display: grid;
				grid-template-columns: 3.5rem 7rem 1fr auto;
				align-items: baseline;
				gap: 1rem;
				padding: 1.35rem 0.5rem;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			.index a:hover {
				background: var(--paper-raise);
			}
			.index .no {
				font-size: 13px;
				font-weight: 700;
				color: var(--accent);
			}
			.index .zh {
				font-size: 1.25rem;
				font-weight: 800;
				letter-spacing: 0.02em;
			}
			.index .en {
				font-family: var(--font-mono);
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.15em;
				color: var(--ink-faint);
			}
			.index .desc {
				color: var(--ink-soft);
				font-size: 0.92em;
			}
			.index .arrow {
				font-family: var(--font-mono);
				color: var(--ink-faint);
				transition:
					transform 0.15s ease,
					color 0.15s ease;
			}
			.index a:hover .arrow {
				transform: translateX(4px);
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.hero {
					padding: 3rem 0 2.5rem;
				}
				.crosshair::before {
					left: -8px;
				}
				.crosshair::after {
					right: -8px;
				}
				.index a {
					grid-template-columns: 2.5rem 1fr auto;
				}
				.index .en,
				.index .desc {
					display: none;
				}
			}
		</style>
	</body>
</html>
