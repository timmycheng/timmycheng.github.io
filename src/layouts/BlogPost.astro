---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { readingMinutes } from '../utils/reading';

type Heading = { depth: number; slug: string; text: string };

type Props = CollectionEntry<'blog'>['data'] & { slug: string; body: string; headings: Heading[] };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	slug,
	body,
	headings,
} = Astro.props;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const related = (await getCollection('blog'))
	.filter((p) => p.id !== slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const minutes = readingMinutes(body);
const pageUrl = Astro.url.href;
const shareUrl = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(title);
const xUrl = `https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main id="main-content" class="container prose-wrap">
			<div class="post-grid">
				<div class="post-main">
					<article>
						<header class="head">
							<p class="eyebrow">
								<a class="link-sweep" href="/works">← <span data-i18n="nav.works">Works</span></a>
							</p>
							<h1>{title}</h1>
							<div class="meta-row">
								<span><FormattedDate date={pubDate} /></span>
								<span class="read">
									<span class="num">{minutes}</span>
									<span data-i18n="read.min">min read</span>
								</span>
								{
									updatedDate && (
										<span class="updated">
											updated <FormattedDate date={updatedDate} />
										</span>
									)
								}
							</div>
							{
								tags.length > 0 && (
									<div class="tags">
										{tags.map((t) => (
											<a class="pill" href="/works">
												{t}
											</a>
										))}
									</div>
								)
							}
						</header>
						{
							heroImage && (
								<div class="hero-image">
									<Image width={1020} height={510} src={heroImage} alt="" />
								</div>
							)
						}
						<div class="prose">
							<slot />
						</div>
						<div class="share">
							<span class="label" data-i18n="post.share">Share</span>
							<a
								class="btn btn-outline share-x"
								href={xUrl}
								target="_blank"
								rel="noopener noreferrer"
								aria-label="X"
							>
								X
							</a>
							<button type="button" class="btn btn-outline share-copy" data-copy={pageUrl}>
								<span data-i18n="post.copy">Copy link</span>
							</button>
						</div>
						{
							related.length > 0 && (
								<section class="related">
									<h2 class="section-title">
										<span data-i18n="related.title">Related posts</span>
									</h2>
									<div class="feed">
										{related.map((p) => (
											<article class="feed-card compact">
												<a class="title-link" href={`/blog/${p.id}/`}>
													<div class="meta-row">
														<span>
															<FormattedDate date={p.data.pubDate} />
														</span>
														<span class="read">
															<span class="num">{readingMinutes(p.body ?? '')}</span>{' '}
															<span data-i18n="read.min">min read</span>
														</span>
													</div>
													<h3 class="title">{p.data.title}</h3>
													<p class="excerpt">{p.data.description}</p>
												</a>
											</article>
										))}
									</div>
								</section>
							)
						}
						<p class="back">
							<a class="link-sweep" href="/works"
								>← <span data-i18n="post.back">Back to Works</span></a
							>
						</p>
						<Comments />
					</article>
				</div>
				{
					toc.length > 0 && (
						<aside class="toc">
							<nav aria-label="Table of contents">
								<p class="toc-title" data-i18n="toc.title">
									Contents
								</p>
								<ul>
									{toc.map((h) => (
										<li class:list={[`depth-${h.depth}`]}>
											<a href={`#${h.slug}`} data-heading={h.slug}>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						</aside>
					)
				}
			</div>
		</main>
		<Footer />
		<script>
			const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-heading]')];
			const targets = links
				.map((a) => document.getElementById(a.dataset.heading || ''))
				.filter((el): el is HTMLElement => el !== null);
			if (targets.length && 'IntersectionObserver' in window) {
				const spy = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								links.forEach((l) =>
									l.classList.toggle('is-active', l.dataset.heading === entry.target.id),
								);
							}
						});
					},
					{ rootMargin: '-20% 0px -70% 0px', threshold: 0 },
				);
				targets.forEach((h) => spy.observe(h));
			}
		</script>
		<script>
			const btn = document.querySelector<HTMLButtonElement>('.share-copy');
			if (btn) {
				const labels = { en: 'Copied', 'zh-CN': '已复制' };
				const span = btn.querySelector<HTMLElement>('[data-i18n]');
				btn.addEventListener('click', async () => {
					const url = btn.dataset.copy;
					if (!url) return;
					try {
						await navigator.clipboard.writeText(url);
					} catch (e) {
						return;
					}
					const locale =
						document.documentElement.getAttribute('data-locale') === 'zh' ? 'zh-CN' : 'en';
					if (span) span.textContent = labels[locale];
					btn.classList.add('copied');
					setTimeout(() => {
						btn.classList.remove('copied');
					}, 2000);
				});
			}
		</script>
		<style>
			main.prose-wrap {
				padding: 0 0 4rem;
			}
			.post-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 230px;
				gap: 2.5rem;
				align-items: start;
			}
			.post-main {
				min-width: 0;
				max-width: var(--layout-content);
			}
			.head {
				padding: 2.5rem 0 1.8rem;
				border-bottom: 2px solid var(--ink);
				margin-bottom: 2.5rem;
			}
			.head .eyebrow a {
				color: var(--ink-soft);
			}
			.head .eyebrow a:hover {
				color: var(--accent);
			}
			.head h1 {
				font-size: clamp(1.8rem, 4.5vw, 2.6rem);
				letter-spacing: -0.03em;
				margin: 0.8rem 0 0.9rem;
			}
			.meta-row .updated {
				color: var(--ink-faint);
			}
			.tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-top: 1rem;
			}
			.hero-image {
				margin-bottom: 2.5rem;
			}
			.hero-image img {
				width: 100%;
				border-radius: var(--radius-md);
				border: 1px solid var(--line-strong);
			}
			.prose {
				max-width: none;
			}
			.share {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin-top: 3rem;
				padding-top: 1.6rem;
				border-top: 1px solid var(--line);
			}
			.share .label {
				margin-right: 0.4rem;
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--ink-faint);
			}
			.share .btn {
				padding: 0.55rem 1.1rem;
				font-size: 12px;
			}
			.share .share-copy.copied {
				border-color: var(--accent);
				color: var(--accent);
			}
			.related {
				margin-top: 3.5rem;
			}
			.related .feed {
				gap: 2.25rem;
			}
			.back {
				margin: 3rem 0 0;
				font-size: 13px;
			}
			.back a {
				color: var(--ink-soft);
			}
			.back a:hover {
				color: var(--accent);
			}
			/* ── 侧边栏 TOC（emDash toc--sidebar） ── */
			.toc {
				position: sticky;
				top: 6rem;
				align-self: start;
			}
			.toc-title {
				margin: 0 0 0.85rem;
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--ink-faint);
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.35rem;
				border-left: 1px solid var(--line-strong);
				padding-left: 1rem;
			}
			.toc a {
				display: block;
				padding: 0.2rem 0 0.2rem 0.55rem;
				margin-left: calc(-1rem - 1px);
				border-left: 2px solid transparent;
				color: var(--ink-faint);
				font-size: 13px;
				line-height: 1.4;
				text-decoration: none;
				transition:
					color var(--duration-fast) ease,
					border-color var(--duration-fast) ease;
			}
			.toc a:hover {
				color: var(--ink-soft);
			}
			.toc a.is-active {
				color: var(--ink);
				font-weight: 700;
				border-left-color: var(--accent);
			}
			.toc .depth-3 {
				padding-left: 0.5rem;
			}
			@media (max-width: 1000px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
				.toc {
					display: none;
				}
			}
		</style>
	</body>
</html>
