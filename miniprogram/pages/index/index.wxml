<view class="page">
	<view class="filters">
		<view
			wx:for="{{filters}}"
			wx:key="key"
			class="chip {{filter === item.key ? 'chip-active' : ''}}"
			bindtap="onFilterTap"
			data-filter="{{item.key}}"
			>{{item.label}}</view
		>
	</view>

	<view wx:if="{{loading}}" class="state">加载中…</view>

	<view wx:elif="{{error}}" class="state">
		<view>内容加载失败，请检查网络</view>
		<button size="mini" bindtap="retry">重试</button>
	</view>

	<view wx:else class="list">
		<view
			wx:for="{{shown}}"
			wx:key="id"
			class="card"
			bindtap="goDetail"
			data-id="{{item.id}}"
		>
			<image wx:if="{{item.hero}}" class="hero" src="{{item.hero}}" mode="aspectFill" lazy-load />
			<view class="meta">
				<text wx:if="{{item.kindLabel}}" class="badge kind-project">{{item.kindLabel}}</text>
				<text wx:if="{{item.pinned}}" class="badge pin">{{item.pinLabel}}</text>
				<text wx:if="{{item.status}}" class="badge">{{item.status}}</text>
				<text class="date">{{item.dateText}}</text>
			</view>
			<view class="title">{{item.title}}</view>
			<view class="desc">{{item.desc}}</view>
			<view wx:if="{{item.tags.length}}" class="tags">
				<text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">#{{tag}}</text>
			</view>
		</view>
		<view wx:if="{{!shown.length}}" class="state">暂无内容</view>
	</view>
</view>
