---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { Lang } from '../i18n';
import { langFromUrl } from '../utils/works';

// 自托管字体：英文 Space Grotesk（可变字重）、代码 JetBrains Mono（可变字重），
// 中文 MiSans（unicode-range 分片按需加载）
// MiSans 的字重声明是小米自家的标尺（Light=250、Medium=380、Bold=630），
// 页面请求 400 时按 CSS 匹配规则命中 Medium，请求 600-900 命中 Bold，引用块 300 命中 Light
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import 'misans/lib/Normal/MiSans-Light.min.css';
import 'misans/lib/Normal/MiSans-Medium.min.css';
import 'misans/lib/Normal/MiSans-Bold.min.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	publishedTime?: Date;
	modifiedTime?: Date;
	/** 页面语言；不传时按 URL 前缀判断（/zh/ → zh） */
	lang?: Lang;
	/** 对应另一语言版本的 URL；提供时输出 hreflang alternate 链接 */
	alternateUrl?: string;
}

const { title, description, image, publishedTime, modifiedTime } = Astro.props;
const lang = Astro.props.lang ?? langFromUrl(Astro.url);
const rssHref = lang === 'zh' ? '/zh/rss.xml' : '/rss.xml';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogType = publishedTime ? 'article' : 'website';
---

<!-- 主题无闪初始化（语言由 /zh/ 路由在构建期决定，不再走客户端切换） -->
<script is:inline>
	(function () {
		var d = document.documentElement;
		var theme = null;
		try {
			theme = localStorage.getItem('tc-theme');
		} catch (e) {}
		if (!theme)
			theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		d.setAttribute('data-theme', theme);

		document.addEventListener('DOMContentLoaded', function () {
			document.querySelectorAll('[data-action="theme"]').forEach(function (btn) {
				btn.addEventListener('click', function () {
					var next = d.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					d.setAttribute('data-theme', next);
					try {
						localStorage.setItem('tc-theme', next);
					} catch (e) {}
					document.dispatchEvent(new CustomEvent('tc-theme-change', { detail: next }));
				});
			});
		});
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssHref} />
{
	// 双语 alternate：仅当页面给出另一语言版本 URL 时输出，指向不存在的页面没有意义
	Astro.props.alternateUrl && (
		<link
			rel="alternate"
			hreflang={lang === 'en' ? 'zh-CN' : 'en'}
			href={new URL(Astro.props.alternateUrl, Astro.site).href}
		/>
	)
}
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url).href} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={new URL(image.src, Astro.url).href} />}

<!-- Mobile browser chrome color -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0efeb" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171410" />
