---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const tiles = [
	{ no: '01', zh: '关于', en: 'About', desc: '我是谁，在做什么', href: '/about' },
	{ no: '02', zh: '文章', en: 'Writing', desc: '技术笔记与随想', href: '/blog' },
	{ no: '03', zh: '项目', en: 'Projects', desc: '做过和正在做的东西', href: '/projects' },
	{ no: '04', zh: '画廊', en: 'Gallery', desc: '摄影与视觉碎片', href: '/gallery' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container">
			<section class="hero">
				<div class="hero-main">
					<p class="mono-label">timmycheng.cn — EST.2026</p>
					<h1 class="name">TIMMY<br />CHENG<span class="accent">.</span></h1>
					<p class="lede">
						软件工程师。做工具、写文字、拍照片——这个网站收集我做出的东西和写下的想法。
					</p>
				</div>
				<dl class="spec mono">
					<div><dt>ROLE</dt><dd>Software Engineer</dd></div>
					<div><dt>FOCUS</dt><dd>Web / Tools</dd></div>
					<div><dt>BASE</dt><dd>CN · UTC+8</dd></div>
					<div><dt>STATUS</dt><dd class="ok"><i class="dot"></i>ONLINE</dd></div>
				</dl>
			</section>

			<section class="tiles" aria-label="栏目入口">
				{
					tiles.map((t) => (
						<a class="tile" href={t.href}>
							<span class="no mono">{t.no}</span>
							<span class="zh">{t.zh}</span>
							<span class="en mono">{t.en}</span>
							<span class="desc">{t.desc}</span>
							<span class="arrow mono">→</span>
						</a>
					))
				}
			</section>

			<section class="latest">
				<div class="latest-head">
					<h2>最近文章</h2>
					<a href="/blog" class="mono more">全部 →</a>
				</div>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="date mono">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="title">{post.data.title}</span>
									<span class="arrow mono">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<style>
			.accent {
				color: var(--accent);
			}
			/* ── hero ── */
			.hero {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 3rem;
				align-items: end;
				padding: 4.5rem 0 3.5rem;
			}
			.name {
				font-size: clamp(3rem, 8.5vw, 5.8rem);
				line-height: 0.95;
				letter-spacing: -0.045em;
				margin: 1.1rem 0 1.3rem;
			}
			.lede {
				max-width: 30em;
				font-size: 1.06em;
				color: var(--ink-soft);
			}
			.spec {
				margin: 0;
				border: 1px solid var(--line-strong);
				background: var(--paper-raise);
				min-width: 240px;
			}
			.spec div {
				display: flex;
				justify-content: space-between;
				gap: 2rem;
				padding: 0.55rem 0.9rem;
				border-bottom: 1px solid var(--line);
				font-size: 12px;
			}
			.spec div:last-child {
				border-bottom: none;
			}
			.spec dt {
				color: var(--ink-faint);
				letter-spacing: 0.12em;
			}
			.spec dd {
				margin: 0;
				font-weight: 600;
			}
			.spec .ok {
				color: var(--accent);
			}
			.spec .dot {
				display: inline-block;
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--accent);
				margin-right: 6px;
				animation: blink 2.4s ease-in-out infinite;
			}
			@keyframes blink {
				50% {
					opacity: 0.35;
				}
			}
			/* ── tiles：细线网格 + 悬停反色 ── */
			.tiles {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1px;
				background: var(--line-strong);
				border: 1px solid var(--line-strong);
			}
			.tile {
				position: relative;
				display: grid;
				grid-template-columns: 1fr auto;
				grid-template-areas:
					'no arrow'
					'zh arrow'
					'en en'
					'desc desc';
				row-gap: 0.2rem;
				column-gap: 1rem;
				padding: 1.6rem 1.5rem 1.4rem;
				background: var(--paper);
				text-decoration: none;
				transition: background 0.18s ease;
			}
			.tile:hover {
				background: var(--ink);
			}
			.tile .no {
				grid-area: no;
				font-size: 12px;
				font-weight: 700;
				color: var(--accent);
			}
			.tile .zh {
				grid-area: zh;
				font-size: 1.55rem;
				font-weight: 800;
				letter-spacing: 0.02em;
				line-height: 1.15;
			}
			.tile .en {
				grid-area: en;
				font-size: 11px;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				color: var(--ink-faint);
			}
			.tile .desc {
				grid-area: desc;
				margin-top: 0.7rem;
				font-size: 0.88em;
				color: var(--ink-soft);
			}
			.tile .arrow {
				grid-area: arrow;
				align-self: start;
				font-size: 16px;
				color: var(--ink-faint);
				transition:
					transform 0.18s ease,
					color 0.18s ease;
			}
			.tile:hover .zh,
			.tile:hover .desc {
				color: var(--paper);
			}
			.tile:hover .en,
			.tile:hover .arrow {
				color: var(--paper-deep);
			}
			.tile:hover .arrow {
				transform: translate(3px, -3px);
				color: var(--accent);
			}
			/* ── latest ── */
			.latest {
				margin-top: 4rem;
			}
			.latest-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				border-bottom: 2px solid var(--ink);
				padding-bottom: 0.6rem;
				margin-bottom: 0.5rem;
			}
			.latest-head h2 {
				margin: 0;
				font-size: 1.3em;
			}
			.latest .more {
				font-size: 13px;
				color: var(--ink-soft);
				text-decoration: none;
			}
			.latest .more:hover {
				color: var(--accent);
			}
			.latest ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.latest li {
				border-bottom: 1px solid var(--line);
			}
			.latest a {
				display: grid;
				grid-template-columns: 8.5rem 1fr auto;
				align-items: baseline;
				gap: 1rem;
				padding: 1rem 0.5rem;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			.latest a:hover {
				background: var(--paper-raise);
			}
			.latest .date {
				font-size: 12px;
				color: var(--ink-faint);
				letter-spacing: 0.05em;
			}
			.latest .title {
				font-weight: 700;
			}
			.latest a:hover .title {
				color: var(--accent);
			}
			.latest .arrow {
				font-size: 14px;
				color: var(--ink-faint);
			}
			@media (max-width: 720px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 2rem;
					padding: 3rem 0 2.5rem;
					align-items: start;
				}
				.tiles {
					grid-template-columns: 1fr;
				}
				.latest a {
					grid-template-columns: 1fr auto;
				}
				.latest .date {
					grid-column: 1 / -1;
				}
			}
		</style>
	</body>
</html>
