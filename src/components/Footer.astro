---
import { SITE_TITLE } from '../consts';

const today = new Date();
const year = today.getFullYear();
---

<footer>
	<div class="inner">
		<div class="brand">
			<span class="wordmark">
				Shxt<span class="accent">.</span>In<span class="accent">.</span>Mind
			</span>
			<p class="sub mono">&copy; {year} {SITE_TITLE} · timmycheng.cn</p>
		</div>

		<div class="center">
			<ul class="socials" aria-label="Social links">
				<li>
					<a
						class="social-btn"
						href="https://github.com/timmycheng"
						target="_blank"
						rel="noopener"
						aria-label="GitHub"
					>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
					</a>
				</li>
				<li>
					<a class="social-btn" href="/rss.xml" aria-label="RSS feed">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
							<path d="M4 4c8.837 0 16 7.163 16 16h-4c0-6.627-5.373-12-12-12V4z"></path>
							<circle cx="6" cy="18" r="2"></circle>
							<path d="M4 11c5 0 9 4 9 9h-3c0-3.314-2.686-6-6-6v-3z"></path>
						</svg>
					</a>
				</li>
			</ul>
			<nav aria-label="Beian">
				<ul>
					<li>
						<a
							class="nav-link link-sweep"
							href="https://beian.miit.gov.cn/"
							target="_blank"
							rel="noopener"
						>
							京ICP备XXXXXXXX号
						</a>
					</li>
				</ul>
			</nav>
		</div>

		<p class="credit mono">
			Built with
			<a href="https://astro.build/" target="_blank" rel="noopener" class="link-quiet underline">
				Astro
			</a>
		</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line-strong);
		padding: 2rem 1.5rem 2.5rem;
		background: transparent;
	}
	.inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2rem;
		width: 1000px;
		max-width: calc(100% - 3rem);
		margin: 0 auto;
	}
	.brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.35rem;
		justify-self: start;
	}
	.wordmark {
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.03em;
	}
	.wordmark .accent {
		color: var(--accent);
	}
	.sub,
	.credit {
		margin: 0;
		font-size: 12px;
		color: var(--ink-faint);
	}
	.center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		justify-self: center;
	}
	.socials {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.5rem;
	}
	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem 1rem;
	}
	.nav-link {
		font-size: 13px;
		color: var(--ink-soft);
	}
	.credit {
		justify-self: end;
	}
	.credit a {
		color: var(--ink-soft);
	}
	.credit a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		footer {
			padding: 2rem 1rem 2.25rem;
		}
		.inner {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			text-align: center;
		}
		.brand,
		.credit {
			align-items: center;
			justify-self: center;
		}
		.center {
			justify-self: center;
		}
	}
</style>
