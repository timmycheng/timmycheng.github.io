---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { readingMinutes } from '../../utils/reading';

type Item = {
	kind: 'post' | 'project';
	id: string;
	href: string;
	title: string;
	description: string;
	date: Date;
	tags: string[];
	body: string;
	heroImage?: CollectionEntry<'blog'>['data']['heroImage'];
	status?: 'wip' | 'active' | 'done';
};

const [posts, projects] = await Promise.all([getCollection('blog'), getCollection('projects')]);
const statusLabel = { wip: 'WIP', active: 'ACTIVE', done: 'DONE' } as const;

const items: Item[] = [
	...posts.map((p) => ({
		kind: 'post' as const,
		id: p.id,
		href: `/blog/${p.id}/`,
		title: p.data.title,
		description: p.data.description,
		date: p.data.pubDate,
		tags: p.data.tags,
		body: p.body ?? '',
		heroImage: p.data.heroImage,
	})),
	...projects.map((p) => ({
		kind: 'project' as const,
		id: p.id,
		href: `/projects/${p.id}/`,
		title: p.data.title,
		description: p.data.description,
		date: p.data.pubDate,
		tags: p.data.tags,
		body: p.body ?? '',
		heroImage: p.data.heroImage,
		status: p.data.status,
	})),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const tagList = [...new Set(items.flatMap((i) => i.tags))].sort();
const tagCount = new Map(tagList.map((t) => [t, items.filter((i) => i.tags.includes(t)).length]));
const [lead, ...rest] = items;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Works · ${SITE_TITLE}`} description="Posts and projects." />
	</head>
	<body>
		<Header />
		<main id="main-content" class="container works">
			<header class="page-head">
				<h1 data-i18n="works.title">Works / 作品</h1>
				<p class="lede" data-i18n="works.sub">Posts and projects.</p>
				<p class="count mono">
					<span class="num">{items.length}</span>
					<span data-i18n="works.items">items</span>
				</p>
			</header>

			<div class="filters" role="group" aria-label="Filter by tag">
				<button type="button" class="pill active" data-tag="" data-i18n="works.all">All</button>
				{
					tagList.map((t) => (
						<button type="button" class="pill" data-tag={t}>
							{t}
							<span class="num"> · {tagCount.get(t)}</span>
						</button>
					))
				}
			</div>

			<ul class="card-grid">
				{
					lead && (
						<li class="card card-lead" data-tags={lead.tags.join(',')}>
							<a class="card-link" href={lead.href} aria-label={lead.title} />
							<figure class="card-media">
								<span class="card-flag" data-i18n={`badge.${lead.kind}`}>
									{lead.kind === 'post' ? 'ARTICLE' : 'PROJECT'}
								</span>
								{lead.heroImage ? (
									<Image
										width={1000}
										src={lead.heroImage}
										alt=""
										widths={[480, 800, 1000]}
										sizes="(max-width: 720px) 100vw, 66vw"
									/>
								) : (
									<div class="card-cover" aria-hidden="true">
										<span>T/</span>
									</div>
								)}
							</figure>
							<div class="card-body">
								<p class="card-kicker" data-i18n="featured">
									FEATURED
								</p>
								<p class="card-meta meta-row">
									<span>
										<FormattedDate date={lead.date} />
									</span>
									<span class="read">
										<span class="num">{readingMinutes(lead.body)}</span>{' '}
										<span data-i18n="read.min">min read</span>
									</span>
								</p>
								<h2>{lead.title}</h2>
								<p class="desc">{lead.description}</p>
								<div class="foot">
									<div class="tags">
										{lead.tags.map((t) => (
											<span class="pill">{t}</span>
										))}
									</div>
									{lead.status && (
										<span class:list={['status', lead.status]}>{statusLabel[lead.status]}</span>
									)}
								</div>
							</div>
						</li>
					)
				}
				{
					rest.map((item) => (
						<li class="card" data-tags={item.tags.join(',')}>
							<a class="card-link" href={item.href} aria-label={item.title} />
							<figure class="card-media">
								<span class="card-flag" data-i18n={`badge.${item.kind}`}>
									{item.kind === 'post' ? 'ARTICLE' : 'PROJECT'}
								</span>
								{item.heroImage ? (
									<Image
										width={600}
										src={item.heroImage}
										alt=""
										widths={[320, 600]}
										sizes="(max-width: 720px) 100vw, 33vw"
									/>
								) : (
									<div class="card-cover" aria-hidden="true">
										<span>T/</span>
									</div>
								)}
							</figure>
							<div class="card-body">
								<p class="card-meta meta-row">
									<span>
										<FormattedDate date={item.date} />
									</span>
									<span class="read">
										<span class="num">{readingMinutes(item.body)}</span>{' '}
										<span data-i18n="read.min">min read</span>
									</span>
								</p>
								<h2>{item.title}</h2>
								<p class="desc">{item.description}</p>
								<div class="foot">
									<div class="tags">
										{item.tags.map((t) => (
											<span class="pill">{t}</span>
										))}
									</div>
									{item.status && (
										<span class:list={['status', item.status]}>{statusLabel[item.status]}</span>
									)}
								</div>
							</div>
						</li>
					))
				}
			</ul>
			<p class="empty" data-i18n="works.empty" hidden>No items match this tag.</p>
		</main>
		<Footer />
		<script>
			const pills = [...document.querySelectorAll<HTMLButtonElement>('.filters .pill')];
			const cards = [...document.querySelectorAll<HTMLElement>('.card')];
			const empty = document.querySelector<HTMLElement>('.empty');
			pills.forEach((pill) =>
				pill.addEventListener('click', () => {
					const tag = pill.dataset.tag || '';
					pills.forEach((p) => p.classList.toggle('active', p === pill));
					let shown = 0;
					cards.forEach((card) => {
						const tags = (card.dataset.tags || '').split(',').map((s) => s.trim());
						const visible = !tag || tags.includes(tag);
						card.hidden = !visible;
						if (visible) shown++;
					});
					if (empty) empty.hidden = shown > 0;
				}),
			);
		</script>
		<style>
			main.works {
				padding: 2.5rem 0 4rem;
			}
			.page-head {
				margin-bottom: 2rem;
			}
			.page-head h1 {
				font-size: clamp(1.9rem, 5vw, 2.9rem);
				letter-spacing: -0.03em;
				margin: 0 0 0.6rem;
			}
			.page-head .lede {
				margin: 0;
				color: var(--ink-soft);
				max-width: 34em;
			}
			.page-head .count {
				margin: 1rem 0 0;
				font-size: 12px;
				letter-spacing: 0.12em;
				color: var(--ink-faint);
				font-variant-numeric: tabular-nums;
			}
			.page-head .count .num {
				color: var(--accent);
				font-weight: 700;
			}
			.filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin-bottom: 1.6rem;
			}
			.filters .pill {
				padding: 0.3rem 0.65rem;
				font-size: 11px;
				background: var(--paper-raise);
				color: var(--ink-soft);
			}
			.filters .pill .num {
				font-size: 10px;
				opacity: 0.7;
				letter-spacing: 0;
			}
			.filters button.pill.active {
				border-color: var(--accent);
				color: var(--accent);
				background: var(--paper-deep);
			}
			.card-grid {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.2rem;
			}
			/* featured：emDash --list 两栏卡片 */
			.card-lead {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
				align-items: stretch;
			}
			.card-lead .card-media {
				aspect-ratio: auto;
				height: 100%;
				min-height: 17rem;
				border-bottom: none;
				border-right: 1px solid var(--line);
			}
			.card-lead .card-body {
				justify-content: center;
				padding: 2rem;
			}
			.card-lead h2 {
				font-size: clamp(1.5rem, 3.6vw, 2.1rem);
				letter-spacing: -0.02em;
				-webkit-line-clamp: 3;
			}
			.card-lead .desc {
				font-size: 1em;
				-webkit-line-clamp: 3;
			}
			.empty {
				margin: 3rem 0 0;
				font-family: var(--font-mono);
				font-size: 13px;
				letter-spacing: 0.1em;
				color: var(--ink-faint);
			}
			@media (max-width: 720px) {
				.card-lead {
					grid-template-columns: 1fr;
				}
				.card-lead .card-media {
					aspect-ratio: 1200 / 630;
					min-height: 0;
					border-right: none;
					border-bottom: 1px solid var(--line);
				}
				.card-lead .card-body {
					padding: 1.4rem 1.3rem 1.2rem;
				}
			}
		</style>
	</body>
</html>
