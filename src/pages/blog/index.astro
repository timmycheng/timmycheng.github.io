---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Posts · ${SITE_TITLE}`} description="Tech notes and essays." />
	</head>
	<body>
		<Header />
		<main class="container">
			<div class="section-head">
				<span class="no">02</span>
				<h1 data-i18n="nav.writing">Posts</h1>
				<span class="en mono-label">
					<span data-i18n="writing.count">Posts</span> — {posts.length}
					<span data-i18n="writing.unit">posts</span>
				</span>
			</div>
			<ul class="post-list">
				{
					posts.map((post, i) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="no mono">{String(posts.length - i).padStart(2, '0')}</span>
								<span class="title">{post.data.title}</span>
								<span class="desc">{post.data.description}</span>
								<span class="date mono">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<style>
			main.container {
				padding: 0;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--line);
			}
			.post-list li {
				border-bottom: 1px solid var(--line);
			}
			.post-list a {
				display: grid;
				grid-template-columns: 3.5rem 1fr auto;
				align-items: baseline;
				gap: 1rem;
				padding: 1.3rem 0.5rem;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			.post-list a:hover {
				background: var(--paper-raise);
			}
			.post-list .no {
				font-size: 13px;
				font-weight: 700;
				color: var(--accent);
			}
			.post-list .title {
				font-size: 1.15rem;
				font-weight: 700;
			}
			.post-list a:hover .title {
				color: var(--accent);
			}
			.post-list .desc {
				grid-column: 2;
				color: var(--ink-soft);
				font-size: 0.92em;
			}
			.post-list .date {
				font-size: 12px;
				color: var(--ink-faint);
				letter-spacing: 0.06em;
			}
			@media (max-width: 720px) {
				.post-list a {
					grid-template-columns: 2.5rem 1fr;
				}
				.post-list .date {
					grid-column: 2;
				}
			}
		</style>
	</body>
</html>
