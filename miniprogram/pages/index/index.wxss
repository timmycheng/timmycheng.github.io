.page {
	padding: 24rpx 32rpx 48rpx;
}

/* 筛选 */
.filters {
	display: flex;
	gap: 16rpx;
	padding: 8rpx 0 28rpx;
}

.chip {
	font-size: 24rpx;
	padding: 8rpx 28rpx;
	border-radius: 999rpx;
	color: #6b6659;
	background: #ece8df;
}

.chip-active {
	color: #f7f5f0;
	background: #191919;
	font-weight: 600;
}

/* 列表卡片 */
.list {
	display: flex;
	flex-direction: column;
	gap: 28rpx;
}

.card {
	background: #fffdf9;
	border: 1rpx solid #e2ddd1;
	border-radius: 20rpx;
	padding: 32rpx;
	overflow: hidden;
}

.hero {
	width: 100%;
	height: 320rpx;
	border-radius: 12rpx;
	margin-bottom: 24rpx;
}

.meta {
	display: flex;
	align-items: center;
	gap: 12rpx;
	margin-bottom: 14rpx;
}

.date {
	font-size: 22rpx;
	color: #8a8578;
	margin-left: auto;
}

.title {
	font-size: 34rpx;
	font-weight: 700;
	line-height: 1.45;
	color: #191919;
}

.desc {
	margin-top: 12rpx;
	font-size: 26rpx;
	color: #6b6659;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 3;
	overflow: hidden;
}

.tags {
	margin-top: 20rpx;
	display: flex;
	flex-wrap: wrap;
	gap: 16rpx;
}

.tag {
	font-size: 22rpx;
	color: #a0522d;
}
