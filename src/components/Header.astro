---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo" aria-label={SITE_TITLE}>
			<span class="logo-mark">T/</span>
			<span class="logo-text">timmy<span class="logo-dot">.</span>cheng</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/about">关于</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/projects">项目</HeaderLink>
			<HeaderLink href="/gallery">画廊</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0 1.5rem;
		background: rgba(240, 239, 235, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line-strong);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1060px;
		margin: 0 auto;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 14px 0;
		text-decoration: none;
	}
	.logo:hover {
		color: inherit;
	}
	.logo-mark {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 7px;
		background: var(--accent);
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 700;
	}
	.logo-text {
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.03em;
	}
	.logo-dot {
		color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		.logo-text {
			display: none;
		}
	}
</style>
